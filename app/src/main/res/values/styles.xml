<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoviFlexx.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

        <!-- Tema principal de MoviFlex -->
        <style name="Theme.MoviFlexx" parent="Theme.MaterialComponents.DayNight.NoActionBar">
            <item name="colorPrimary">@color/primary</item>
            <item name="colorPrimaryVariant">@color/primaryDark</item>
            <item name="android:statusBarColor">@color/primaryDark</item>
        </style>

        <!-- Botón redondeado -->
        <style name="MoviButton" parent="Widget.MaterialComponents.Button">
            <item name="android:backgroundTint">@color/primary</item>
            <item name="android:textColor">@color/white</item>
            <item name="android:padding">12dp</item>
            <item name="cornerRadius">20dp</item>
        </style>



</resources>