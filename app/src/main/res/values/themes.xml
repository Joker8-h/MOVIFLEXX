<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════
         BASE — Material3 DayNight
    ════════════════════════════════════════════════════ -->
    <style name="Base.Theme.Moviflexx" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">#2EC4B6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#C2F0EB</item>
        <item name="colorOnPrimaryContainer">#0A5550</item>

        <item name="colorSecondary">#4DCFC4</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E6F9F7</item>
        <item name="colorOnSecondaryContainer">#0F756D</item>

        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111827</item>
        <item name="colorSurfaceVariant">#F9FAFB</item>
        <item name="colorOnSurfaceVariant">#4B5563</item>

        <item name="android:colorBackground">#F4F7F6</item>

        <item name="colorError">#EF4444</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:statusBarColor">#2EC4B6</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="shapeAppearanceSmallComponent">@style/Shape.Moviflexx.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Moviflexx.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Moviflexx.Large</item>

        <item name="colorControlHighlight">#332EC4B6</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>

    </style>

    <!-- ════════════════════════════════════════════════════
         TEMA PRINCIPAL
    ════════════════════════════════════════════════════ -->
    <style name="Theme.Moviflexx" parent="Base.Theme.Moviflexx"/>

    <!-- ════════════════════════════════════════════════════
         SPLASH — un solo bloque, hereda de Theme.Moviflexx
         postSplashScreenTheme apunta al tema principal
         para que la transición sea suave
    ════════════════════════════════════════════════════ -->
    <style name="Theme.Moviflexx.Splash" parent="Theme.Moviflexx">
        <item name="android:statusBarColor">#2EC4B6</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">#2EC4B6</item>
        <item name="postSplashScreenTheme">@style/Theme.Moviflexx</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         SHAPES
    ════════════════════════════════════════════════════ -->
    <style name="Shape.Moviflexx.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Moviflexx.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.Moviflexx.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Shape.Moviflexx.Pill" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         BOTONES
    ════════════════════════════════════════════════════ -->
    <style name="Button.Moviflexx.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">#2EC4B6</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
        <item name="elevation">4dp</item>
        <item name="android:stateListAnimator">@animator/btn_elevation_anim</item>
    </style>

    <style name="Button.Moviflexx.White" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#2EC4B6</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
        <item name="elevation">4dp</item>
        <item name="android:stateListAnimator">@animator/btn_elevation_anim</item>
    </style>

    <style name="Button.Moviflexx.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#2EC4B6</item>
        <item name="strokeColor">#2EC4B6</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
    </style>

    <style name="Button.Moviflexx.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#2EC4B6</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         CARDS
    ════════════════════════════════════════════════════ -->
    <style name="Card.Moviflexx" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Card.Moviflexx.Teal" parent="Card.Moviflexx">
        <item name="cardBackgroundColor">#29B4A8</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Card.Moviflexx.Flat" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">#E6F9F7</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#C2F0EB</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         INPUTS
    ════════════════════════════════════════════════════ -->
    <style name="Input.Moviflexx" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/input_stroke_selector</item>
        <item name="hintTextColor">#2EC4B6</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Input.Moviflexx.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxBackgroundColor">#F4F7F6</item>
        <item name="hintTextColor">#2EC4B6</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         BOTTOM NAVIGATION
    ════════════════════════════════════════════════════ -->
    <style name="BottomNav.Moviflexx" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="android:background">#FFFFFF</item>
        <item name="elevation">12dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         CHIPS
    ════════════════════════════════════════════════════ -->
    <style name="Chip.Moviflexx.Status" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">#E6F9F7</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">#1A9E92</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">28dp</item>
    </style>

    <style name="Chip.Moviflexx.Warning" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">#FEF3C7</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">#D97706</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">28dp</item>
    </style>

    <style name="Chip.Moviflexx.Error" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">#FEE2E2</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">#DC2626</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">28dp</item>
    </style>

    <!-- ════════════════════════════════════════════════════
         FAB
    ════════════════════════════════════════════════════ -->
    <style name="FAB.Moviflexx" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">#2EC4B6</item>
        <item name="tint">#FFFFFF</item>
        <item name="elevation">8dp</item>
    </style>

</resources>