<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FFFE">

    <!-- ══════════════════════════════════════
         MAPA (ocupa toda la pantalla)
    ══════════════════════════════════════ -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_ver_ruta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- ══════════════════════════════════════
         BOTÓN ATRÁS (top-left)
    ══════════════════════════════════════ -->
    <ImageButton
        android:id="@+id/btn_back_ver_ruta"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:src="@drawable/ic_arrow_back"
        android:elevation="8dp"
        android:contentDescription="Atrás"/>

    <!-- ══════════════════════════════════════
         ZOOM CONTROLS (right side)
    ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:elevation="8dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_zoom_in_pasajero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add"
            app:backgroundTint="#FFFFFF"
            app:tint="#1A2422"
            app:fabSize="mini"
            android:layout_marginBottom="8dp"
            android:elevation="4dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_zoom_out_pasajero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_remove"
            app:backgroundTint="#FFFFFF"
            app:tint="#1A2422"
            app:fabSize="mini"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- ══════════════════════════════════════
         BOTTOM SHEET — info de la ruta + parada
    ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_sheet_ver_ruta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="220dp"
        app:behavior_hideable="false">

        <!-- Handle de arrastrar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#CBD5E1"
            android:clipToOutline="true"/>

        <!-- ScrollView interno para contenido largo -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- ── CARD INFO RUTA DEL CONDUCTOR ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_info_ruta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#B2DFDB"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RUTA DEL CONDUCTOR"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#009B8D"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="8dp"/>

                        <!-- Origen -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/circle_green"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/txt_origen_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textColor="#374151"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <!-- Línea vertical -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="14dp"
                            android:background="#CBD5E1"
                            android:layout_marginStart="5dp"
                            android:layout_marginBottom="4dp"/>

                        <!-- Destino -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/circle_red"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/txt_destino_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textColor="#374151"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <!-- Distancia | Duración | Costo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">
                                <TextView
                                    android:id="@+id/txt_distancia_info"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#009B8D"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="distancia"
                                    android:textSize="10sp"
                                    android:textColor="#94A3B8"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">
                                <TextView
                                    android:id="@+id/txt_duracion_info"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#3B82F6"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="duración"
                                    android:textSize="10sp"
                                    android:textColor="#94A3B8"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">
                                <TextView
                                    android:id="@+id/txt_info_extra"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#10B981"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="costo/tipo"
                                    android:textSize="10sp"
                                    android:textColor="#94A3B8"/>
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── CARD PARADA DEL PASAJERO ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_parada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#DDD6FE"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TU PARADA"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#6366F1"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/txt_parada_pasajero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937"
                            android:layout_marginBottom="8dp"/>

                        <!-- Loader mientras geocodifica -->
                        <ProgressBar
                            android:id="@+id/loader_parada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:visibility="gone"
                            android:indeterminateTint="#6366F1"
                            android:layout_marginBottom="4dp"/>

                        <!-- Estado de la parada -->
                        <TextView
                            android:id="@+id/txt_estado_parada"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#F59E0B"
                            android:text="🔍 Buscando tu parada en el mapa..."
                            android:layout_marginBottom="10dp"
                            android:lineSpacingExtra="2dp"/>

                        <!-- Botón confirmar parada -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_confirmar_parada"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="CONFIRMAR MI PARADA"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#6366F1"
                            app:cornerRadius="12dp"
                            android:enabled="false"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── BOTÓN SOLICITAR VIAJE ── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_solicitar_viaje"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="SOLICITAR VIAJE 🚗"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#009B8D"
                    app:cornerRadius="16dp"
                    android:enabled="false"
                    android:alpha="0.0"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>