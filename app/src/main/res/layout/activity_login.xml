<?xml version="1.0" encoding="utf-8"?>
<!--
    MOVIFLEXX — activity_login.xml (VERSIÓN FINAL CORREGIDA)
    Raíz: FrameLayout — permite superponer el login normal y la cámara facial
    ✓ layoutLogin  → ScrollView con el formulario (visible al inicio)
    ✓ layoutFace   → ConstraintLayout con cámara (gone al inicio)
    ✓ Sin app:startIconSize (no existe en Material)
    ✓ Íconos ic_email y ic_lock en 24dp desde el vector drawable
    ✓ Google con app:iconTint="@null" para colores reales
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondomoviflexxx">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  STEP 1 — FORMULARIO DE LOGIN (visible al inicio)         -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ILUSTRACIÓN DEL CARRO -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:adjustViewBounds="true"
                android:contentDescription="MOVIFLEXX ilustración"
                android:scaleType="fitCenter"
                android:src="@drawable/moviflesx" />

            <!-- FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="36dp">

                <!-- LOGO HORIZONTAL -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="28dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logomo"
                        android:contentDescription="Logo MOVIFLEX" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOVIFLEX"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2EC4B6"
                        android:layout_marginStart="10dp"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <!-- CAMPO EMAIL — ícono viene del vector ic_email.xml (24dp) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Correo electrónico"
                    app:errorEnabled="true"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="#888888"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="#CCCCCC"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#999999"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#2B2B2B"
                        android:textSize="15sp"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO CONTRASEÑA — candado de ic_lock.xml (24dp) + ojo toggle -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contraseña"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#AAAAAA"
                    app:errorEnabled="true"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#888888"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="#CCCCCC"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#999999"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#2B2B2B"
                        android:textSize="15sp"
                        android:padding="14dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTÓN INICIAR SESIÓN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:onClick="login"
                    android:text="Iniciar Sesión"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"
                    app:cornerRadius="14dp"
                    app:elevation="4dp"
                    app:rippleColor="#80FFFFFF" />

                <!-- SEPARADOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E8E8E8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  o continúa con  "
                        android:textColor="#BBBBBB"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E8E8E8" />

                </LinearLayout>

                <!-- FILA QR + FACIAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQrLogin"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:onClick="irQrScanner"
                        android:text="QR"
                        android:textColor="#2EC4B6"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_qr_code"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        app:iconTint="#2EC4B6"
                        app:strokeColor="#2EC4B6"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:rippleColor="#202EC4B6" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFaceLogin"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:onClick="irFaceLogin"
                        android:text="Facial"
                        android:textColor="#2EC4B6"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_camera"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        app:iconTint="#2EC4B6"
                        app:strokeColor="#2EC4B6"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:rippleColor="#202EC4B6" />

                </LinearLayout>

                <!-- BOTÓN GOOGLE — app:iconTint="@null" muestra los 4 colores reales -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Continuar con Google"
                    android:textColor="#3C4043"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_google"
                    app:iconSize="20dp"
                    app:iconPadding="10dp"
                    app:iconTint="@null"
                    app:strokeColor="#DADCE0"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:rippleColor="#10000000" />

                <!-- ¿NO TIENES CUENTA? -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿No tienes una cuenta? "
                        android:textSize="13sp"
                        android:textColor="#999999" />

                    <TextView
                        android:id="@+id/tvRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Regístrate"
                        android:textSize="13sp"
                        android:textColor="#2EC4B6"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="irRegister" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  STEP 2 — RECONOCIMIENTO FACIAL (gone al inicio)          -->
    <!--  Login.java lo activa con layoutFace.setVisibility(VISIBLE) -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutFace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:scaleType="fillCenter" />

        <!-- Óvalo guía -->
        <View
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:background="@drawable/face_oval_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Título cámara -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reconocimiento Facial"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:padding="12dp"
            android:background="#80000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Estado / instrucción -->
        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:text="📷 Coloca tu rostro frente a la cámara..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAlignment="center"
            android:padding="16dp"
            android:background="#80000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>