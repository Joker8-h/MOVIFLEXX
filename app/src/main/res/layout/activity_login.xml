<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2FBFA">

    <!-- ═══════════════════════════════════════════
         BLOB decorativo — superior derecho
    ═══════════════════════════════════════════ -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_blob_login"
        android:alpha="0.18"
        android:clickable="false"/>

    <!-- ═══════════════════════════════════════════
         BLOB decorativo — inferior izquierdo
    ═══════════════════════════════════════════ -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_blob_login"
        android:alpha="0.13"
        android:clickable="false"/>

    <!-- ═══════════════════════════════════════════
         STEP 1 — FORMULARIO LOGIN (visible al inicio)
    ═══════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/fondomoviflex"
            android:gravity="center_horizontal">

            <!-- ── Ilustración van ── -->
            <ImageView
                android:layout_width="280dp"
                android:layout_height="180dp"
                android:layout_marginTop="48dp"
                android:adjustViewBounds="true"
                android:contentDescription="MoviFlex ilustración"
                android:scaleType="fitCenter"
                android:src="@drawable/moviflesx"/>

            <!-- ── FORMULARIO CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="8dp"
                android:paddingEnd="28dp"
                android:paddingBottom="40dp">

                <!-- ── Logo MOVI + FLEX ── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="9dp"
                        android:src="@drawable/logomo"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOVI"
                        android:textColor="#2C3E50"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FLEX"
                        android:textColor="#1ABC9C"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"/>
                </LinearLayout>

                <!-- ════════════════════════════
                     CAMPO EMAIL
                ════════════════════════════ -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="Correo electrónico"
                    app:errorEnabled="true"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="#9E9E9E"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="@color/selector_input_stroke_light"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/selector_input_hint_light"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#2C3E50"
                        android:textSize="15sp"
                        android:padding="14dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ════════════════════════════
                     CAMPO CONTRASEÑA
                ════════════════════════════ -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Contraseña"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#9E9E9E"
                    app:errorEnabled="true"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#9E9E9E"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxStrokeColor="@color/selector_input_stroke_light"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/selector_input_hint_light"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#2C3E50"
                        android:textSize="15sp"
                        android:padding="14dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ════════════════════════════
                     BOTÓN INICIAR SESIÓN
                     Teal sólido, radius 14dp, bold
                ════════════════════════════ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="20dp"
                    android:onClick="login"
                    android:text="Iniciar Sesión"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="#1ABC9C"
                    app:cornerRadius="14dp"
                    app:elevation="4dp"
                    app:rippleColor="#40FFFFFF"/>

                <!-- ════════════════════════════
                     SEPARADOR
                ════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E0E0E0"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  o continúa con  "
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E0E0E0"/>
                </LinearLayout>

                <!-- ════════════════════════════
                     FILA QR + FACIAL
                     Outline teal, radius 12dp
                ════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQrLogin"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:onClick="irQrScanner"
                        android:text="QR"
                        android:textColor="#1ABC9C"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_qr_code"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        app:iconTint="#1ABC9C"
                        app:strokeColor="#1ABC9C"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:rippleColor="#201ABC9C"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFaceLogin"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:onClick="irFaceLogin"
                        android:text="Facial"
                        android:textColor="#1ABC9C"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_camera"
                        app:iconSize="18dp"
                        app:iconPadding="6dp"
                        app:iconTint="#1ABC9C"
                        app:strokeColor="#1ABC9C"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:rippleColor="#201ABC9C"/>
                </LinearLayout>

                <!-- ════════════════════════════
                     BOTÓN GOOGLE
                ════════════════════════════ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:text="Continuar con Google"
                    android:textColor="#3C4043"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_google"
                    app:iconSize="20dp"
                    app:iconPadding="10dp"
                    app:iconTint="@null"
                    app:strokeColor="#DADCE0"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:rippleColor="#10000000"/>

                <!-- ════════════════════════════
                     ¿NO TIENES CUENTA?
                ════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿No tienes una cuenta?  "
                        android:textSize="13sp"
                        android:textColor="#9E9E9E"/>

                    <TextView
                        android:id="@+id/tvRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Regístrate"
                        android:textSize="13sp"
                        android:textColor="#1ABC9C"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="irRegister"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════════
         STEP 2 — RECONOCIMIENTO FACIAL (gone al inicio)
         Login.java lo activa con layoutFace.setVisibility(VISIBLE)
    ═══════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutFace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:scaleType="fillCenter"/>

        <!-- Óvalo guía cara -->
        <View
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:background="@drawable/face_oval_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Título cámara -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reconocimiento Facial"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:padding="12dp"
            android:background="#80000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Instrucción estado facial -->
        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:text="📷 Coloca tu rostro frente a la cámara..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAlignment="center"
            android:padding="16dp"
            android:background="#80000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>