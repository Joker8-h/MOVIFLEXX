<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Logo Container -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="144dp"
        android:layout_height="148dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:background="@drawable/fondomoviflex"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
    </LinearLayout>

    <!-- Input Fields Container -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logoContainer"
        android:layout_marginStart="32dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical">

        <!-- Email Input -->
        <EditText
            android:id="@+id/edtcorreoo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:background="@drawable/input_background"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/background_white"
            android:textSize="16sp" />

        <!-- Password Input -->
        <EditText
            android:id="@+id/edtcontrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_background"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="16sp" />

        <!-- Login Button -->
        <Button
            android:id="@+id/btnlogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:onClick="irsuccess"
            android:backgroundTint="@color/colorPrimary"
            android:text="@string/login"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Social Login Container -->
    <LinearLayout
        android:id="@+id/socialContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/inputContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/googleLogin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/google"
            android:contentDescription="@string/login_google"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/facebookLogin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/facebook"
            android:contentDescription="@string/login_facebook"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Go to Register -->
    <TextView
        android:id="@+id/btn_ir_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="irRegister"
        android:layout_below="@id/socialContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"
        android:text="@string/registerr"
        android:textColor="#006666"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>
