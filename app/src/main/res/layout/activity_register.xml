<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="22dp"
    android:background="#F7F7F7">

    <!-- Título -->
    <TextView
        android:id="@+id/tv_register_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo nombres -->
    <EditText
        android:id="@+id/edtnombre"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/register_nombres"
        android:padding="14dp"
        android:textSize="16sp"
        android:inputType="textPersonName"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_register_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo teléfono -->
    <EditText
        android:id="@+id/edtphone"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/register_phone"
        android:padding="14dp"
        android:textSize="16sp"
        android:inputType="phone"
        android:layout_marginTop="16dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/edtnombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo email -->
    <EditText
        android:id="@+id/edtemail"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/register_email"
        android:padding="14dp"
        android:textSize="16sp"
        android:inputType="textEmailAddress"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtphone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo contraseña -->
    <EditText
        android:id="@+id/edtpassword"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/register_password"
        android:padding="14dp"
        android:textSize="16sp"
        android:inputType="textPassword"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtemail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Confirmar contraseña -->
    <EditText
        android:id="@+id/edtconfirmpassword"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="@string/register_confirm_password"
        android:padding="14dp"
        android:textSize="16sp"
        android:inputType="textPassword"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtpassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spinner corregido -->
    <Spinner
        android:id="@+id/spinner_tipo"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:padding="14dp"
        android:entries="@array/Rol"
        android:textColor="@color/black"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtconfirmpassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Términos y condiciones -->
    <CheckBox
        android:id="@+id/cb_terms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_terms"
        android:textSize="14sp"
        android:textColor="#444444"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/spinner_tipo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botón registrar -->
    <Button
        android:id="@+id/btn_register"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="@string/register_button"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#006666"
        android:elevation="4dp"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintTop_toBottomOf="@id/cb_terms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_go_login" />

    <!-- Link a login -->
    <TextView
        android:id="@+id/tv_go_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="irLogin0"
        android:text="@string/register_go_login"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#006666"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
