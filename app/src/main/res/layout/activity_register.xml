<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="22dp"
        android:background="#F7F7F7">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tv_register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NOMBRES -->
        <EditText
            android:id="@+id/edtnombre"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="@string/hint_nombre"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textPersonName"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tv_register_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- TELÉFONO -->
        <EditText
            android:id="@+id/edtphone"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="@string/hint_phone"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="phone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtnombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- EMAIL -->
        <EditText
            android:id="@+id/edtemail"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="@string/hint_email"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textEmailAddress"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtphone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONTRASEÑA -->
        <EditText
            android:id="@+id/edtpassword"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="@string/hint_password"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textPassword"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtemail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_show_pass" />

        <ImageButton
            android:id="@+id/btn_show_pass"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_eye_close"
            android:padding="6dp"
            app:layout_constraintTop_toTopOf="@id/edtpassword"
            app:layout_constraintBottom_toBottomOf="@id/edtpassword"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONFIRMAR CONTRASEÑA -->
        <EditText
            android:id="@+id/edtconfirmpassword"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="@string/hint_confirm_password"
            android:padding="14dp"
            android:textSize="16sp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textPassword"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtpassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_show_pass_confirm" />

        <ImageButton
            android:id="@+id/btn_show_pass_confirm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_eye_close"
            android:padding="6dp"
            app:layout_constraintTop_toTopOf="@id/edtconfirmpassword"
            app:layout_constraintBottom_toBottomOf="@id/edtconfirmpassword"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- SPINNER ROL -->
        <Spinner
            android:id="@+id/spinner_tipo"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:padding="14dp"
            android:entries="@array/tipo_usuario"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtconfirmpassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CHECK TÉRMINOS -->
        <CheckBox
            android:id="@+id/cb_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_terms"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@id/spinner_tipo"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- LAYOUT VEHÍCULO -->
        <LinearLayout
            android:id="@+id/layout_vehicle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/cb_terms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/img_vehicle_preview"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_launcher_background"
                android:scaleType="centerCrop"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btn_upload_image"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_upload_vehicle"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:backgroundTint="#006666"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/edtplaca"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/hint_placa"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:padding="14dp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/edtmodelo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/hint_modelo"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:padding="14dp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/edtcolor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/hint_color"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:padding="14dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- BOTÓN REGISTRAR -->
        <Button
            android:id="@+id/btn_register"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="@string/btn_register"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:onClick="irSuccessRegister"
            android:backgroundTint="#006666"
            android:layout_marginTop="34dp"
            app:layout_constraintTop_toBottomOf="@id/layout_vehicle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- YA TIENES CUENTA -->
        <TextView
            android:id="@+id/tv_go_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_go_login"
            android:onClick="irLogin02"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="28dp"
            app:layout_constraintTop_toBottomOf="@id/btn_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>


