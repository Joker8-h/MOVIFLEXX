                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/calificacion"/>
                </LinearLayout>
            </LinearLayout>


            <!-- Botón ver detalles -->
            <com.google.android.material.button.MaterialButton

