                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/calificacion"/>

                    <ImageView android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/calificacion"/>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginStart="2dp"
                        android:contentDescription="@string/calificacion"/>

                    <ImageView
