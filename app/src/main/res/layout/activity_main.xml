<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Efecto de brillo animado en el fondo -->
    <View
        android:id="@+id/shine_effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:background="@drawable/movi"/>

    <!-- Partículas flotantes decorativas -->
    <View
        android:id="@+id/particle_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/particle_circle"
        android:alpha="0.0"/>

    <View
        android:id="@+id/particle_2"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="200dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/particle_circle"
        android:alpha="0.0"/>

    <View
        android:id="@+id/particle_3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="100dp"
        android:layout_marginBottom="150dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/particle_circle"
        android:alpha="0.0"/>

    <!-- Contenedor principal con CardView para efecto de elevación -->
    <androidx.cardview.widget.CardView
        android:id="@+id/main_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:cardBackgroundColor="#00000000"
        app:cardElevation="0dp"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Círculo decorativo detrás del logo -->
            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp">

                <!-- Círculo exterior animado -->
                <View
                    android:id="@+id/circle_outer"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_ripple"
                    android:alpha="0.0"/>

                <!-- Círculo medio -->
                <View
                    android:id="@+id/circle_middle"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_glow"
                    android:alpha="0.0"/>

                <!-- Logo con sombra -->
                <androidx.cardview.widget.CardView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="110dp"
                    app:cardElevation="12dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/splash_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/movi"
                        android:contentDescription="@string/splash_logo_description"
                        android:scaleType="fitCenter"
                        android:padding="40dp"
                        android:alpha="0.0"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Contenedor del nombre con efecto glassmorphism -->
            <LinearLayout
                android:id="@+id/text_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:alpha="0.0">

                <!-- Nombre de la app con gradiente -->
                <TextView
                    android:id="@+id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="42sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="8"/>

                <!-- Línea decorativa -->
                <View
                    android:id="@+id/decorative_line"
                    android:layout_width="120dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/line_gradient"
                    android:alpha="0.9"/>

                <!-- Slogan con animación -->
                <TextView
                    android:id="@+id/app_slogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/splash_slogan"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.95"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="12dp"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"/>
            </LinearLayout>

            <!-- Indicador de carga moderno -->
            <FrameLayout
                android:id="@+id/progress_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:alpha="0.0">

                <!-- Círculo de fondo -->
                <ProgressBar
                    android:id="@+id/splash_progress_bg"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminateTint="#40FFFFFF"/>

                <!-- Círculo principal -->
                <ProgressBar
                    android:id="@+id/splash_progress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminateTint="#FFFFFF"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Versión con diseño premium -->
    <LinearLayout
        android:id="@+id/version_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:alpha="0.0"
        android:gravity="center">

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="#60FFFFFF"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_version"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:alpha="0.85"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.1"
            android:layout_marginHorizontal="12dp"/>

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="#60FFFFFF"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

</RelativeLayout>