<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navbar"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Ilustración Scooter & Logo Rapitipica según Boceto 1 (Splash) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:strokeColor="#33E30613"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="#FF161B22">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_domiflex"
                android:contentDescription="Rapitipica — Lo que quieres, en un clic"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rapitipica"
            android:textSize="36sp"
            android:textStyle="bold|italic"
            android:gravity="center"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="36dp"
            android:text="Lo que quieres, en un clic"
            android:gravity="center"
            android:textColor="#FFD1D5DB"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplorar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Comenzar"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Iniciar sesión"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
