<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════
             HEADER TEAL BOLD
             ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="192dp"
            android:background="@drawable/fondomoviflexxx"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="52dp"
            android:paddingEnd="22dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.14"
                android:text="MOVIFLEXX · CONDUCTOR"
                android:textColor="#B2EDE8"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:letterSpacing="-0.01"
                android:text="Planifica tu ruta"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Chips GPS + contador — mismos IDs que el original -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <View
                        android:id="@+id/dot_gps"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/circle_green_dot" />

                    <TextView
                        android:id="@+id/txt_estado_gps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="Buscando GPS..."
                        android:textColor="#B2EDE8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_contador_rutas"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_icon_circle_white_alpha"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_contador_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="0 rutas"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════
             CUERPO
             ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- ── SELECTOR VEHÍCULO ── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Moviflexx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEHÍCULO"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_600"
                        android:letterSpacing="0.16"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_transporte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:chipSpacingHorizontal="10dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_carro"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Carro"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:chipIcon="@drawable/ic_car"
                            app:chipIconSize="18dp"
                            app:chipBackgroundColor="@drawable/chip_background_selector"
                            app:chipStrokeColor="@drawable/chip_stroke_selector"
                            app:chipStrokeWidth="1.5dp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_moto"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Moto"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:chipIcon="@drawable/ic_moto"
                            app:chipIconSize="18dp"
                            app:chipBackgroundColor="@drawable/chip_background_selector"
                            app:chipStrokeColor="@drawable/chip_stroke_selector"
                            app:chipStrokeWidth="1.5dp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"/>

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ORIGEN / DESTINO ── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Moviflexx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUNTOS DE VIAJE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_600"
                        android:letterSpacing="0.16"
                        android:layout_marginBottom="14dp"/>

                    <!-- Origen -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="6dp">
                            <View
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:background="@drawable/circle_green_dot"/>
                        </LinearLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Input.Moviflexx"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Punto de partida">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_origen"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/gray_900"
                                android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Conector visual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">
                            <View
                                android:layout_width="2dp"
                                android:layout_height="22dp"
                                android:background="@color/gray_200"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Destino -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="6dp">
                            <View
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:background="@drawable/circle_red_dot"/>
                        </LinearLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Input.Moviflexx"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="¿A dónde vas?">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_destino"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/gray_900"
                                android:imeOptions="actionSearch"
                                android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Botón calcular -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_calcular_ruta"
                        style="@style/Button.Moviflexx.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Calcular rutas"
                        app:icon="@android:drawable/ic_menu_directions"
                        app:iconSize="18dp"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── MAPA ── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Moviflexx"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView
                        android:id="@+id/map_mini"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <!-- Leyenda franja superior -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_gravity="top"
                        android:background="#CC1A2422"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <View android:layout_width="20dp" android:layout_height="3dp" android:background="@color/teal_400"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Rápida" android:textSize="9sp" android:textColor="#AAFFFFFF" android:layout_marginEnd="10dp"/>
                        <View android:layout_width="20dp" android:layout_height="3dp" android:background="@color/yellow_500"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Alt. 1" android:textSize="9sp" android:textColor="#AAFFFFFF" android:layout_marginEnd="10dp"/>
                        <View android:layout_width="20dp" android:layout_height="3dp" android:background="@color/red_500"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Alt. 2" android:textSize="9sp" android:textColor="#AAFFFFFF" android:layout_marginEnd="10dp"/>
                        <View android:layout_width="20dp" android:layout_height="3dp" android:background="#3B82F6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Alt. 3" android:textSize="9sp" android:textColor="#AAFFFFFF"/>
                    </LinearLayout>

                    <!-- Loader overlay -->
                    <LinearLayout
                        android:id="@+id/loader_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#AAFFFFFF"
                        android:visibility="gone">
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Card.Moviflexx"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            app:cardElevation="8dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="20dp">
                                <ProgressBar
                                    android:id="@+id/loader_ruta"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:indeterminateTint="@color/teal_500"
                                    android:layout_marginBottom="10dp"/>
                                <TextView
                                    android:id="@+id/txt_loader_msg"
                                    android:tag="loader_msg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Calculando..."
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/teal_600"
                                    android:gravity="center"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- FABs zoom -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fab_zoom_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:contentDescription="Acercar"
                            app:fabSize="mini"
                            app:backgroundTint="#FFFFFF"
                            app:tint="@color/gray_800"
                            app:srcCompat="@drawable/ic_zoom_in"
                            app:elevation="5dp"/>
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fab_zoom_out"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Alejar"
                            app:fabSize="mini"
                            app:backgroundTint="#FFFFFF"
                            app:tint="@color/gray_800"
                            app:srcCompat="@drawable/ic_zoom_out"
                            app:elevation="5dp"/>
                    </LinearLayout>

                    <!-- FAB mi ubicación -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_mi_ubicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="10dp"
                        android:contentDescription="Mi ubicación"
                        app:fabSize="mini"
                        app:backgroundTint="@color/teal_500"
                        app:tint="#FFFFFF"
                        app:srcCompat="@android:drawable/ic_menu_mylocation"
                        app:elevation="5dp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BANNER INFO RUTA ── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Moviflexx.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="40dp"
                        android:background="@color/teal_500"
                        android:layout_marginEnd="14dp"/>
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@android:drawable/ic_menu_directions"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Info"/>
                    <TextView
                        android:id="@+id/txt_info_ruta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ingresa el destino y presiona Calcular rutas"
                        android:textColor="@color/teal_700"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECCIÓN RUTAS OPCIONES ── -->
            <LinearLayout
                android:id="@+id/card_rutas_opciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@color/teal_500"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OPCIONES DE RUTA"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_600"
                        android:letterSpacing="0.16"/>
                    <TextView
                        android:id="@+id/txt_contador_rutas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="10sp"
                        android:textColor="@color/gray_400"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_rutas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>

            <!-- ── BOTÓN PUBLICAR ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publicar_ruta"
                style="@style/Button.Moviflexx.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_login"
                android:layout_marginBottom="28dp"
                android:text="Publicar ruta"
                app:icon="@drawable/ic_car"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>