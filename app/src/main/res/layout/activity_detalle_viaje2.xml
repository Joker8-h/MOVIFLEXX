<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#6C3BFF"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle del viaje"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ===== MAPA ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mapa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/card_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.osmdroid.views.MapView
            android:id="@+id/map_mini"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== INFO VIAJE ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/card_acciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt_info_ruta"
                android:text="Origen → Destino"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1A1C1E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txt_estado"
                android:text="Estado"
                android:textColor="#6C3BFF"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txt_conductor"
                android:text="👤 Conductor"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/txt_vehiculo"
                android:text="🚘 Vehículo"
                android:alpha="0.7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== ACCIONES ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_acciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- CONDUCTOR -->
            <Button
                android:id="@+id/btn_iniciar"
                android:text="INICIAR VIAJE"
                android:visibility="gone"
                android:backgroundTint="#2E7D32"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>

            <Button
                android:id="@+id/btn_finalizar"
                android:text="FINALIZAR VIAJE"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:backgroundTint="#C62828"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>

            <Button
                android:id="@+id/btn_parada"
                android:text="AGREGAR PARADA"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:backgroundTint="#6C3BFF"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>

            <!-- PASAJERO -->
            <Button
                android:id="@+id/btn_seleccionar_parada"
                android:text="SELECCIONAR PARADA"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:backgroundTint="#455A64"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
