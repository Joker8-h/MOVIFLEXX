<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ══════════════════════════════════════════════
         HEADER TURQUESA DEGRADADO
         ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila título + loader -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:text="DETALLE DEL VIAJE"
                    android:textColor="#A8EEE6"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/txt_info_ruta"
                    android:text="Origen → Destino"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/loader_detalle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:visibility="gone"
                android:indeterminateTint="#FFFFFF"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

        <!-- Badge de estado -->
        <TextView
            android:id="@+id/txt_estado"
            android:text="● Estado"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_estado_badge"/>

        <!-- Pills métricas rápidas -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Conductor -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView android:text="🚗" android:textSize="14sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:text="CONDUCTOR" android:textSize="8sp"
                            android:textColor="#00897B" android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/txt_conductor" android:text="Cargando..."
                            android:textColor="#004D40" android:textSize="12sp" android:textStyle="bold"
                            android:maxWidth="110dp" android:maxLines="1" android:ellipsize="end"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Distancia -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView android:text="📏" android:textSize="14sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:text="DISTANCIA" android:textSize="8sp"
                            android:textColor="#00897B" android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/txt_distancia_ruta" android:text="-- km"
                            android:textColor="#004D40" android:textSize="12sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Duración -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView android:text="⏱️" android:textSize="14sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:text="DURACIÓN" android:textSize="8sp"
                            android:textColor="#00897B" android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/txt_duracion_ruta" android:text="-- min"
                            android:textColor="#004D40" android:textSize="12sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Precio -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_white"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">
                    <TextView android:text="💵" android:textSize="14sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:text="PRECIO" android:textSize="8sp"
                            android:textColor="#00897B" android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/txt_precio" android:text="$ --"
                            android:textColor="#004D40" android:textSize="12sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════
         SCROLL PRINCIPAL
         ══════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp">

            <!-- ══════════════════════════════════════
                 MAPA
                 ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mapa"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="2dp"
                app:strokeColor="#B2DFDB">

                <org.osmdroid.views.MapView
                    android:id="@+id/map_mini"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 CARD INFO: VEHÍCULO + FECHA
                 ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <!-- Título sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:text="INFORMACIÓN DEL VIAJE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#00897B"
                            android:letterSpacing="0.16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Fila vehículo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_row_subtle"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_teal_light">
                            <TextView android:text="🚘" android:textSize="18sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:text="VEHÍCULO"
                                android:textSize="9sp" android:textColor="#80CBC4"
                                android:textStyle="bold" android:letterSpacing="0.1"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/txt_vehiculo" android:text="—"
                                android:textColor="#37474F" android:textSize="13sp"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila fecha/hora -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_row_subtle"
                        android:padding="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:background="@drawable/bg_icon_teal_light">
                            <TextView android:text="📅" android:textSize="18sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:text="SALIDA"
                                android:textSize="9sp" android:textColor="#80CBC4"
                                android:textStyle="bold" android:letterSpacing="0.1"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/txt_fecha_hora" android:text="—"
                                android:textColor="#37474F" android:textSize="13sp"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Desglose precio -->
                    <TextView
                        android:id="@+id/txt_desglose_precio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#00695C"
                        android:background="@drawable/bg_card_teal_subtle"
                        android:padding="12dp"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.5"/>

                    <!-- Container MI RESERVA -->
                    <LinearLayout
                        android:id="@+id/container_mi_reserva"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 CARD CUPOS
                 ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cupos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <!-- Encabezado cupos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:text="DISPONIBILIDAD"
                                android:textSize="10sp" android:textStyle="bold"
                                android:textColor="#00897B" android:letterSpacing="0.16"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="Cupos del viaje"
                                android:textSize="14sp" android:textStyle="bold"
                                android:textColor="#004D40"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Badge en vivo -->
                        <TextView
                            android:text=" 🔄 EN VIVO "
                            android:textSize="9sp"
                            android:textColor="#00897B"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:background="@drawable/bg_live_badge"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- layout_cupos: llenado desde Java -->
                    <LinearLayout
                        android:id="@+id/layout_cupos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 CARD RECORRIDO / PARADAS
                 ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_historial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <!-- Encabezado recorrido -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:text="RECORRIDO"
                                android:textSize="10sp" android:textStyle="bold"
                                android:textColor="#00897B" android:letterSpacing="0.16"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="Paradas de esta ruta"
                                android:textSize="14sp" android:textStyle="bold"
                                android:textColor="#004D40"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_historial_paradas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 CARD ACCIONES
                 ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_acciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <!-- ══ BOTÓN PAGAR VIAJE (pasajero — aparece al ser recogido) ══ -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pagar_viaje"
                        android:text="💳  Pagar viaje"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:letterSpacing="0.03"
                        android:layout_marginBottom="10dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#1565C0"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF"
                        app:iconPadding="8dp"/>

                    <!-- Separador visual (solo visible si btn_pagar_viaje está visible) -->
                    <View
                        android:id="@+id/divider_pago"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0F2F1"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp"/>

                    <!-- Elegir / cambiar parada (pasajero) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reservar"
                        android:text="🚏  ELEGIR PARADA"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.04"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#00897B"/>

                    <!-- Chat conductor -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mensaje_conductor"
                        android:text="💬  CHATEAR CON EL CONDUCTOR"
                        android:visibility="gone"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#0097A7"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF"
                        app:iconPadding="8dp"/>

                    <!-- Iniciar viaje (conductor) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_iniciar"
                        android:text="▶  INICIAR VIAJE"
                        android:visibility="gone"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#00897B"/>

                    <!-- Finalizar viaje (conductor) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_finalizar"
                        android:text="⏹  FINALIZAR VIAJE"
                        android:visibility="gone"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#00695C"/>

                    <!-- Agregar parada (conductor) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_parada"
                        android:text="➕  AGREGAR PARADA"
                        android:visibility="gone"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#26A69A"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>