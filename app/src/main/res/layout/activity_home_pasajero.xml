<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F2F1">

    <!-- SCROLL VIEW PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER CON NOMBRE DINÁMICO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#00796B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="32dp"
                    android:background="@drawable/bg_btn_login">

                    <TextView
                        android:text="Hola 👋"
                        android:textColor="#B2DFDB"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tv_nombre_usuario"
                        android:text="Cargando..."
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Viajes disponibles para ti"
                        android:textColor="#B2DFDB"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECCIÓN: PROMOCIONES DESTACADAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:text="🎉 Promociones"
                        android:textColor="#004D40"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tv_ver_todas_promociones"
                        android:text="Ver todo"
                        android:textColor="#00796B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"/>
                </LinearLayout>

                <!-- SCROLL HORIZONTAL DE PROMOCIONES -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp">

                        <!-- TARJETA PROMOCIÓN 1 - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_promo_1"
                            android:layout_width="280dp"
                            android:layout_height="160dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#26A69A"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:text="20% OFF"
                                    android:textColor="#FFFFFF"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="En tu primer viaje"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginTop="4dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="Código: BIENVENIDO"
                                    android:textColor="#B2DFDB"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif"
                                    android:layout_marginTop="8dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- TARJETA PROMOCIÓN 2 - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_promo_2"
                            android:layout_width="280dp"
                            android:layout_height="160dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#00ACC1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:text="🎁 GRATIS"
                                    android:textColor="#FFFFFF"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="Viaje al aeropuerto"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginTop="4dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="Reserva 3 viajes y gana"
                                    android:textColor="#B2EBF2"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif"
                                    android:layout_marginTop="8dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- TARJETA PROMOCIÓN 3 - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_promo_3"
                            android:layout_width="280dp"
                            android:layout_height="160dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#00897B"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:text="🚗 2x1"
                                    android:textColor="#FFFFFF"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="Viajes compartidos"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginTop="4dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>

                                <TextView
                                    android:text="Válido hasta el 28 Feb"
                                    android:textColor="#A7FFEB"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif"
                                    android:layout_marginTop="8dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- SECCIÓN: DESTINOS POPULARES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:text="📍 Destinos Populares"
                        android:textColor="#004D40"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tv_ver_mapa"
                        android:text="Ver mapa"
                        android:textColor="#00796B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"/>
                </LinearLayout>

                <!-- SCROLL HORIZONTAL DE DESTINOS -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp">

                        <!-- DESTINO 1: AEROPUERTO - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_destino_aeropuerto"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="100dp"
                                    android:background="#B2DFDB">

                                    <TextView
                                        android:text="✈️"
                                        android:textSize="48sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:text="Aeropuerto"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Desde $25.000"
                                        android:textColor="#00796B"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif"
                                        android:layout_marginTop="4dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- DESTINO 2: CENTRO - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_destino_centro"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="100dp"
                                    android:background="#80CBC4">

                                    <TextView
                                        android:text="🏛️"
                                        android:textSize="48sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:text="Centro"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Desde $8.000"
                                        android:textColor="#00796B"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif"
                                        android:layout_marginTop="4dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- DESTINO 3: UNIVERSIDAD - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_destino_universidad"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="100dp"
                                    android:background="#4DB6AC">

                                    <TextView
                                        android:text="🎓"
                                        android:textSize="48sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:text="Universidad"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Desde $6.000"
                                        android:textColor="#00796B"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif"
                                        android:layout_marginTop="4dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- DESTINO 4: TERMINAL - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_destino_terminal"
                            android:layout_width="140dp"
                            android:layout_height="180dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="100dp"
                                    android:background="#26A69A">

                                    <TextView
                                        android:text="🚌"
                                        android:textSize="48sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:text="Terminal"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Desde $10.000"
                                        android:textColor="#00796B"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif"
                                        android:layout_marginTop="4dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- SECCIÓN: NOTICIAS Y CONSEJOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:text="📰 Noticias y Consejos"
                    android:textColor="#004D40"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- SCROLL HORIZONTAL DE NOTICIAS -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp">

                        <!-- NOTICIA 1 - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_noticia_1"
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="3dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="120dp"
                                    android:background="#80CBC4">

                                    <TextView
                                        android:text="💡"
                                        android:textSize="56sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <TextView
                                        android:text="Consejos de seguridad"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Aprende cómo viajar de forma segura y cómoda"
                                        android:textColor="#546E7A"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif"
                                        android:lineSpacingExtra="2dp"
                                        android:layout_marginTop="6dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- NOTICIA 2 - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_noticia_2"
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="3dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="120dp"
                                    android:background="#4DB6AC">

                                    <TextView
                                        android:text="🌱"
                                        android:textSize="56sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <TextView
                                        android:text="Viajes eco-friendly"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Comparte tu viaje y reduce tu huella de carbono"
                                        android:textColor="#546E7A"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif"
                                        android:lineSpacingExtra="2dp"
                                        android:layout_marginTop="6dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- NOTICIA 3 - CLICABLE -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_noticia_3"
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="3dp"
                            app:cardBackgroundColor="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="120dp"
                                    android:background="#26A69A">

                                    <TextView
                                        android:text="⭐"
                                        android:textSize="56sp"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <TextView
                                        android:text="Programa de puntos"
                                        android:textColor="#004D40"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>

                                    <TextView
                                        android:text="Acumula puntos y obtén viajes gratis"
                                        android:textColor="#546E7A"
                                        android:textSize="12sp"
                                        android:fontFamily="sans-serif"
                                        android:lineSpacingExtra="2dp"
                                        android:layout_marginTop="6dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- SECCIÓN: ACCIÓN RÁPIDA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#00796B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:text="¿Necesitas un viaje?"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Encuentra conductores cerca de ti"
                            android:textColor="#B2DFDB"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buscar_viaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscar"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#00796B"
                        app:cornerRadius="20dp"
                        app:backgroundTint="#FFFFFF"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/bottom_navigation_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:elevation="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>