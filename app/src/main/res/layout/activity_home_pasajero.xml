<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ══════════════════════════════════════════════════════
         HEADER HERO — mismo teal sólido que el conductor
    ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#00CED1"
        android:paddingStart="22dp"
        android:paddingTop="36dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Blob decorativo top-right -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"
                android:alpha="0.15"
                android:background="@drawable/bg_glow_circle_teal"
                android:clickable="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ── Fila: Avatar + Saludo + Campana ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- Avatar con anillo blanco y punto online -->
                    <!-- POR ESTO: -->
                    <FrameLayout
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="14dp">


                        <!-- Card inicial (logo, visible por defecto) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_avatar_inicial_header"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="23dp"
                            app:cardElevation="4dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:contentDescription="Logo"
                                android:src="@drawable/logomo" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card foto real Cloudinary (oculta por defecto) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_avatar_foto_header"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            app:cardCornerRadius="23dp"
                            app:cardElevation="4dp"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="1.5dp">

                            <ImageView
                                android:id="@+id/iv_avatar_header"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Foto de perfil"/>
                        </com.google.android.material.card.MaterialCardView>


                    </FrameLayout>

                    <!-- Saludo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_saludo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buenos días,"
                            android:textColor="#CCFFFE"
                            android:textSize="12sp"
                            android:letterSpacing="0.04"/>

                        <TextView
                            android:id="@+id/tv_nombre_usuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="¿A dónde vas hoy?"
                            android:textColor="#CCFFFE"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Campana notificaciones -->
                    <FrameLayout
                        android:id="@+id/btn_notificaciones"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_icon_circle_white_alpha">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notifications"
                            app:tint="#FFFFFF"
                            android:contentDescription="Notificaciones"/>

                        <TextView
                            android:id="@+id/tv_badge_notif"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_red"
                            android:visibility="gone"
                            android:text="0"/>
                    </FrameLayout>

                </LinearLayout>

                <!-- ── BOTÓN MIS VIAJES ── -->
                <!-- Blanco con texto teal — consistente con conductor -->
                <FrameLayout
                    android:id="@+id/btn_mis_viajes_frame"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="6dp"
                    android:background="@drawable/bg_btn_white_rounded">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="false">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_car"
                            android:layout_marginEnd="10dp"
                            app:tint="#00CED1"
                            android:contentDescription="Mis viajes"/>

                        <TextView
                            android:id="@+id/btn_mis_viajes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MIS VIAJES REALIZADOS"
                            android:textColor="#00CED1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:clickable="false"/>
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════
         SCROLL PRINCIPAL
    ══════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- ════════════════════════════════════════════
                 SECCIÓN: POR CALIFICAR
            ════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/section_por_calificar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_calificaciones_pendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <View
                android:id="@+id/divider_calificar"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:background="#D0ECEC"
                android:visibility="gone" />

            <!-- ════════════════════════════════════════════
                 SECCIÓN: PAGOS PENDIENTES
            ════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/section_pagos_pendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_pagos_pendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <View
                android:id="@+id/divider_pagos"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:background="#D0ECEC"
                android:visibility="gone" />

            <!-- ════════════════════════════════════════════
                 SECCIÓN: RUTAS FRECUENTES
            ════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Encabezado con barra acento teal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Barra acento izquierda — igual que conductor -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_line_teal_rounded"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rutas Frecuentes"
                            android:textColor="#1A2F4A"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_subtitulo_rutas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tus destinos más usados"
                            android:textColor="#7A9BAA"
                            android:textSize="12sp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- ProgressBar -->
                <ProgressBar
                    android:id="@+id/pb_rutas"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:indeterminateTint="#00CED1"
                    android:visibility="visible"/>

                <!-- Scroll horizontal rutas -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_rutas_frecuentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp"/>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:background="#D0ECEC"/>

            <!-- ════════════════════════════════════════════
                 SECCIÓN: ¿SABÍAS QUE?
            ════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <!-- Encabezado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_line_teal_rounded"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="¿Sabías que?"
                        android:textColor="#1A2F4A"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MoviFlex Tips"
                        android:textColor="#00CED1"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_carrusel_info"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <!-- Dots indicadores -->
                <LinearLayout
                    android:id="@+id/layout_dots_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"/>

            </LinearLayout>

            <!-- ════════════════════════════════════════════
                 CTA: BUSCAR VIAJE
                 Card con fondo teal degradado igual al
                 botón "GUARDAR CAMBIOS" de la web
            ════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="80dp"
                app:cardBackgroundColor="#00CED1"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <!-- Ícono decorativo izquierda -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_icon_circle_white_alpha">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_compass"
                            app:tint="#FFFFFF"
                            android:contentDescription="Buscar"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿No encuentras tu viaje?"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Busca por origen y destino"
                            android:textColor="#CCFFFE"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Botón blanco con texto teal -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buscar_viaje"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Buscar"
                        android:textColor="#00CED1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="21dp"
                        app:elevation="2dp"
                        app:rippleColor="#2000CED1"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════════════
         BOTTOM NAVIGATION
    ══════════════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/BottomNav.Moviflexx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="16dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_navigation_menu"/>

</androidx.constraintlayout.widget.ConstraintLayout>