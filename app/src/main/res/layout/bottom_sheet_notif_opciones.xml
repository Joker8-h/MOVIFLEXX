<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingBottom="16dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#DDDDDD"
        android:backgroundTint="#CCCCCC"/>

    <!-- Header: avatar + texto de la notif -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bs_card_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#12A89D"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/bs_tv_inicial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="C"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/bs_tv_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Carlos te envió un mensaje"
            android:textColor="#1C1E21"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Divisor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4E6EB"
        android:layout_marginBottom="4dp"/>

    <!-- Opción: Marcar como leída / no leída -->
    <LinearLayout
        android:id="@+id/bs_opcion_leida"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F2F5"
            app:strokeWidth="0dp">
            <ImageView
                android:id="@+id/bs_icon_leida"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_check_circle"
                android:padding="10dp"
                app:tint="#1C1E21"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/bs_texto_leida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marcar como leída"
            android:textColor="#1C1E21"
            android:textSize="15sp"/>
    </LinearLayout>

    <!-- Opción: Abrir destino (viaje/chat según tipo) -->
    <LinearLayout
        android:id="@+id/bs_opcion_abrir"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F2F5"
            app:strokeWidth="0dp">
            <ImageView
                android:id="@+id/bs_icon_abrir"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_directions_car"
                android:padding="10dp"
                app:tint="#1C1E21"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/bs_texto_abrir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver viaje"
            android:textColor="#1C1E21"
            android:textSize="15sp"/>
    </LinearLayout>

    <!-- Opción: Eliminar notificación -->
    <LinearLayout
        android:id="@+id/bs_opcion_eliminar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFF0F0"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_delete"
                android:padding="10dp"
                app:tint="#D32F2F"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar esta notificación"
            android:textColor="#D32F2F"
            android:textSize="15sp"/>
    </LinearLayout>

    <!-- Opción: Desactivar este tipo de notificaciones -->
    <LinearLayout
        android:id="@+id/bs_opcion_desactivar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F2F5"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_notifications_off"
                android:padding="10dp"
                app:tint="#1C1E21"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/bs_texto_desactivar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desactivar notificaciones de mensajes"
                android:textColor="#1C1E21"
                android:textSize="15sp"/>
            <TextView
                android:id="@+id/bs_subtexto_desactivar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ya no recibirás avisos de este tipo"
                android:textColor="#65676B"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>