<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_perfil_usuario.xml
    DrawerLayout como raíz → permite el Navigation Drawer estilo Gmail.
    La card de "Configuraciones" (switch, idioma, etc.) se elimina porque
    esas opciones viven ahora en el Navigation Drawer.
    Todo lo demás es idéntico al original de PerfilUsuario.java.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ════════════════════════════════════════════════════
         CONTENIDO PRINCIPAL
    ════════════════════════════════════════════════════ -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0FAFA">

        <!-- ── BOTTOM NAV ── -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/BottomNav.Moviflexx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:elevation="16dp"
            app:menu="@menu/bottom_navigation_menu" />

        <!-- ── APPBAR ── -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="225dp"
                android:background="@drawable/fondooomoviflex"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="36dp"
                android:paddingEnd="22dp"
                android:paddingBottom="28dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false">

                    <!-- Blob decorativo -->
                    <View
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-40dp"
                        android:layout_marginEnd="-40dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_glow_circle_teal"
                        android:clickable="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Fila: ← btn_back | Título | ⚙️ btn_configuraciones -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Botón atrás -->
                            <FrameLayout
                                android:id="@+id/btn_back"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_circle_white_alpha"
                                android:clickable="true"
                                android:elevation="4dp"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Volver"
                                    android:src="@drawable/ic_arrow_back"
                                    app:tint="#7A9BAA" />
                            </FrameLayout>

                            <!-- Títulos MOVIFLEX / Mi Perfil -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.18"
                                    android:text="MOVIFLEX"
                                    android:textColor="#00CED1"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mi Perfil"
                                    android:textColor="#1A2F4A"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!--
                                ⚙️ BOTÓN CONFIGURACIONES
                                Java: btnConf.setOnClickListener(v -> abrirDrawer())
                            -->
                            <FrameLayout
                                android:id="@+id/btn_configuraciones"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_circle_white_alpha"
                                android:clickable="true"
                                android:elevation="4dp"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Configuraciones"
                                    android:src="@drawable/ic_settings"
                                    app:tint="#7A9BAA" />
                            </FrameLayout>

                        </LinearLayout>

                        <!-- Avatar + nombre + chip rol -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp">

                                <!--
                                    card_avatar_inicial → visible cuando NO hay foto
                                    Java: cardAvatarInicial / tvInicialAvatar
                                -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/card_avatar_inicial"
                                    android:layout_width="74dp"
                                    android:layout_height="74dp"
                                    android:layout_gravity="center"
                                    app:cardBackgroundColor="#1EFFFFFF"
                                    app:cardCornerRadius="37dp"
                                    app:cardElevation="6dp"
                                    app:strokeWidth="0dp">

                                    <TextView
                                        android:id="@+id/tv_inicial_avatar"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:textColor="#FFFFFF"
                                        android:textSize="32sp"
                                        android:textStyle="bold"
                                        tools:text="C" />
                                </com.google.android.material.card.MaterialCardView>

                                <!--
                                    card_avatar_foto → visible cuando SÍ hay foto (Cloudinary)
                                    Java: cardAvatarFoto / ivAvatar
                                    Glide carga la URL desde session.getFotoPerfil()
                                -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/card_avatar_foto"
                                    android:layout_width="74dp"
                                    android:layout_height="74dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    app:cardCornerRadius="37dp"
                                    app:cardElevation="6dp"
                                    app:strokeColor="#FFFFFF"
                                    app:strokeWidth="2dp">

                                    <ImageView
                                        android:id="@+id/iv_avatar"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="Foto de perfil"
                                        android:scaleType="centerCrop" />
                                </com.google.android.material.card.MaterialCardView>

                            </FrameLayout>

                            <!-- Nombre + Chip rol -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- Java: tvNombre ← session.getNombre() -->
                                <TextView
                                    android:id="@+id/tv_nombre"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="6dp"
                                    android:textColor="#1A2F4A"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="Carlos López" />

                                <!-- Java: tvTipoUsuario ← "Conductor" / "Pasajero" -->
                                <com.google.android.material.chip.Chip
                                    android:id="@+id/tv_tipo_usuario"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:clickable="false"
                                    android:textColor="#00CED1"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:chipBackgroundColor="#FFFFFF"
                                    app:chipCornerRadius="15dp"
                                    app:chipStrokeWidth="0dp"
                                    tools:text="Conductor" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ════════════════════════════════════════════════
             SCROLL PRINCIPAL
        ════════════════════════════════════════════════ -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0FAFA">

                <LinearLayout
                    android:id="@+id/layout_perfil_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="100dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- ══════════════════════════════════════
                         CARD: Información de contacto
                         Java: tvEmail, tvTelefono
                    ══════════════════════════════════════ -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#D0ECEC"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Encabezado -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginBottom="18dp">
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="22dp"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/bg_line_teal_rounded"/>
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Información de contacto"
                                    android:textColor="#1A2F4A"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Email -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginBottom="14dp">
                                <FrameLayout
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:background="@drawable/bg_icon_circle_teal_light">
                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Email"
                                        android:src="@drawable/ic_email"
                                        app:tint="#00CED1" />
                                </FrameLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Correo electrónico"
                                        android:textColor="#7A9BAA"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tv_email"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#1A2F4A"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        tools:text="carlos@email.com" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#EEF5F5"
                                android:layout_marginBottom="14dp"/>

                            <!-- Teléfono -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <FrameLayout
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:background="@drawable/bg_icon_circle_teal_light">
                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Teléfono"
                                        android:src="@drawable/ic_phone"
                                        app:tint="#00CED1" />
                                </FrameLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Teléfono"
                                        android:textColor="#7A9BAA"
                                        android:textSize="11sp" />
                                    <TextView
                                        android:id="@+id/tv_telefono"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#1A2F4A"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        tools:text="3212148615" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ══════════════════════════════════════
                         SECCIÓN VEHÍCULO (solo conductor)
                         Java: layoutVehiculoRoot → VISIBLE si isConductor()
                              layoutSelectorVehiculo → si hay >1 vehículo
                              layoutSinVehiculo      → si lista vacía
                              card_info_vehiculo     → si hay vehículo
                    ══════════════════════════════════════ -->
                    <LinearLayout
                        android:id="@+id/layout_vehiculo_root"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Spinner de carga -->
                        <ProgressBar
                            android:id="@+id/progress_vehiculo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="12dp"
                            android:indeterminateTint="#00CED1"
                            android:visibility="gone" />

                        <!-- Selector vehículo múltiple -->
                        <LinearLayout
                            android:id="@+id/layout_selector_vehiculo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_btn_white_rounded"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginBottom="10dp"
                            android:elevation="2dp"
                            android:visibility="gone">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="Vehículos"
                                android:src="@drawable/ic_car"
                                app:tint="#00CED1" />
                            <TextView
                                android:id="@+id/tv_vehiculo_actual"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#00CED1"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:text="Vehículo 1 de 2" />
                            <TextView
                                android:id="@+id/tv_cambiar_vehiculo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cambiar →"
                                android:textColor="#00CED1"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Sin vehículo registrado -->
                        <LinearLayout
                            android:id="@+id/layout_sin_vehiculo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                app:cardBackgroundColor="#E0FFFE"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#A0E0DC"
                                app:strokeWidth="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="16dp">
                                    <FrameLayout
                                        android:layout_width="44dp"
                                        android:layout_height="44dp"
                                        android:layout_marginEnd="12dp"
                                        android:background="@drawable/bg_icon_circle_white_alpha">
                                        <ImageView
                                            android:layout_width="22dp"
                                            android:layout_height="22dp"
                                            android:layout_gravity="center"
                                            android:contentDescription="Info vehículo"
                                            android:src="@drawable/ic_car"
                                            app:tint="#00CED1" />
                                    </FrameLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Vehículo no registrado"
                                            android:textColor="#1A2F4A"
                                            android:textSize="13sp"
                                            android:textStyle="bold"
                                            android:layout_marginBottom="4dp"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Si eres conductor y aún no has registrado tu vehículo, debes hacerlo desde nuestra plataforma web."
                                            android:textColor="#7A9BAA"
                                            android:textSize="12sp"
                                            android:lineSpacingMultiplier="1.4"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_registrar_vehiculo_web"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:text="Registrar vehículo en la web"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:backgroundTint="#00CED1"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_car"
                                app:iconSize="18dp"
                                app:iconPadding="8dp"
                                app:iconTint="#FFFFFF"
                                app:elevation="4dp"
                                app:rippleColor="#40FFFFFF"/>
                        </LinearLayout>

                        <!-- Card vehículo registrado -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_info_vehiculo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#D0ECEC"
                            app:strokeWidth="1dp"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <!-- Encabezado Mi Vehículo -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="18dp">
                                    <View
                                        android:layout_width="4dp"
                                        android:layout_height="22dp"
                                        android:layout_marginEnd="10dp"
                                        android:background="@drawable/bg_line_teal_rounded"/>
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Mi Vehículo"
                                        android:textColor="#1A2F4A"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                    <com.google.android.material.chip.Chip
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:text="✓ Verificado"
                                        android:textColor="#00868A"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        app:chipBackgroundColor="#E0FFFE"
                                        app:chipCornerRadius="14dp"
                                        app:chipStrokeWidth="0dp"
                                        android:clickable="false"
                                        android:focusable="false"/>
                                </LinearLayout>

                                <!-- Icono carro + modelo + placa -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="16dp">
                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="70dp"
                                        android:layout_height="70dp"
                                        android:layout_marginEnd="16dp"
                                        app:cardBackgroundColor="#E0FFFE"
                                        app:cardCornerRadius="16dp"
                                        app:cardElevation="0dp"
                                        app:strokeColor="#A0E0DC"
                                        app:strokeWidth="1dp">
                                        <ImageView
                                            android:layout_width="36dp"
                                            android:layout_height="36dp"
                                            android:layout_gravity="center"
                                            android:contentDescription="Carro"
                                            android:src="@drawable/ic_car"
                                            app:tint="#00CED1"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <!-- Java: tvModelo ← marca + modelo -->
                                        <TextView
                                            android:id="@+id/tv_modelo_vehiculo"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="#1A2F4A"
                                            android:textSize="16sp"
                                            android:textStyle="bold"
                                            android:layout_marginBottom="4dp"
                                            tools:text="Chevrolet Spark" />
                                        <!-- Java: tvPlaca ← "Placa: " + placa -->
                                        <TextView
                                            android:id="@+id/tv_placa_vehiculo"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="#00868A"
                                            android:textSize="13sp"
                                            android:textStyle="bold"
                                            android:paddingStart="10dp"
                                            android:paddingEnd="10dp"
                                            android:paddingTop="4dp"
                                            android:paddingBottom="4dp"
                                            android:background="@drawable/bg_chip_teal"
                                            tools:text="AAA-123" />
                                    </LinearLayout>
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#EEF5F5"
                                    android:layout_marginBottom="14dp"/>

                                <!-- Capacidad / asientos -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <FrameLayout
                                        android:layout_width="42dp"
                                        android:layout_height="42dp"
                                        android:background="@drawable/bg_icon_circle_teal_light">
                                        <ImageView
                                            android:layout_width="18dp"
                                            android:layout_height="18dp"
                                            android:layout_gravity="center"
                                            android:contentDescription="Asientos"
                                            android:src="@drawable/ic_seat"
                                            app:tint="#00CED1"/>
                                    </FrameLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Capacidad"
                                            android:textColor="#7A9BAA"
                                            android:textSize="11sp" />
                                        <!-- Java: tvAsientos ← "Capacidad: N asientos" -->
                                        <TextView
                                            android:id="@+id/tv_asientos"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="#1A2F4A"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            tools:text="4 asientos" />
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- ══════════════════════════════════════
                         CALIFICACIONES
                         Java: layoutCalificacionesContainer
                         se rellena dinámicamente por renderizarSeccionCalificaciones()
                    ══════════════════════════════════════ -->
                    <LinearLayout
                        android:id="@+id/layout_calificaciones_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp" />

                    <!-- ══════════════════════════════════════
                         BANNER: Edición solo en la web
                    ══════════════════════════════════════ -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="#E0FFFE"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#A0E0DC"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">
                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginEnd="14dp"
                                android:background="@drawable/bg_icon_circle_white_alpha">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Info"
                                    android:src="@drawable/ic_info"
                                    app:tint="#00CED1" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Edición solo en la web"
                                    android:textColor="#1A2F4A"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="3dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Para cambiar tu nombre, teléfono o contraseña, visita nuestra web."
                                    android:textColor="#7A9BAA"
                                    android:textSize="12sp"
                                    android:lineSpacingMultiplier="1.3"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ══════════════════════════════════════
                         BOTONES ACCIÓN
                         Java: btnEditarPerfil → mostrarDialogoEditarWeb()
                               btnCerrarSesion → confirmarCerrarSesion()
                    ══════════════════════════════════════ -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_editar_perfil"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="12dp"
                        android:text="Editar perfil en la web"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.04"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#00CED1"
                        app:cornerRadius="14dp"
                        app:elevation="4dp"
                        app:rippleColor="#40FFFFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cerrar_sesion"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Cerrar sesión"
                        android:textSize="14sp"
                        android:textColor="#00CED1"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#00CED1"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="14dp"
                        app:rippleColor="#1400CED1"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ════════════════════════════════════════════════════
         NAVIGATION DRAWER — panel lateral derecho al deslizar
         Java (BaseActivity): setupDrawer() enlaza drawer_layout y nav_view
         Header cargado por: sincronizarHeaderDrawer()
    ════════════════════════════════════════════════════ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header_moviflex"
        app:menu="@menu/nav_drawer_menu"
        app:itemIconTint="#00CED1"
        app:itemTextColor="#1A2F4A"
        app:itemRippleColor="#1A00CED1" />

</androidx.drawerlayout.widget.DrawerLayout>