<?xml version="1.0" encoding="utf-8"?>
<!--
    item_mensaje_recibido.xml
    Burbuja IZQUIERDA (mensajes del contacto)
    Blanco/gris muy claro, misma estructura que item_mensaje_propio.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="10dp"
    android:paddingEnd="60dp">

    <!-- Separador de fecha (HEADER DE FECHA) — se muestra si es un nuevo día -->
    <TextView
        android:id="@+id/tvFechaHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_fecha_pill"
        android:text="Hoy"
        android:textSize="11sp"
        android:textColor="#1AB99F"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"/>
    <!--
        bg_fecha_pill.xml:
        <shape android:shape="rectangle">
          <solid android:color="#E0F8F3"/>
          <corners android:radius="12dp"/>
          <stroke android:width="1dp" android:color="#B2EDE6"/>
        </shape>
    -->

    <!-- Burbuja del mensaje -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_received"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:minWidth="60dp"
        android:maxWidth="260dp">
        <!--
            bg_bubble_received.xml:
            <shape android:shape="rectangle">
              <solid android:color="#FFFFFF"/>
              <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp"/>
              <stroke android:width="1dp" android:color="#E8F6F3"/>
            </shape>
        -->

        <!-- Contenido del mensaje -->
        <TextView
            android:id="@+id/tvContenido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje recibido"
            android:textSize="15sp"
            android:textColor="#1A2E2B"
            android:lineSpacingExtra="2dp"/>

        <!-- Pie: hora + estado de envío -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- HORA — siempre visible -->
            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:30"
                android:textSize="10sp"
                android:textColor="#99B8B4"
                android:layout_marginEnd="4dp"/>

            <!-- Ícono de estado: enviando / enviado / entregado / leído -->
            <!-- enviando   → reloj ⏱  (icono_clock.xml) -->
            <!-- enviado    → ✓ gris   -->
            <!-- entregado  → ✓✓ gris  -->
            <!-- leído      → ✓✓ teal  -->
            <TextView
                android:id="@+id/tvTicks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="11sp"
                android:textColor="#99B8B4"/>

            <!-- Indicador de "enviando" (spinner mini) -->
            <ProgressBar
                android:id="@+id/pbEnviando"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:indeterminateTint="#99B8B4"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>