<?xml version="1.0" encoding="utf-8"?>
<!--
    item_mensaje_recibido.xml
    Burbuja IZQUIERDA (mensajes del contacto)
    Blanco/gris muy claro, sin punto verde automático
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="10dp"
    android:paddingEnd="60dp">

    <!-- Separador de fecha — se muestra si es un nuevo día -->
    <TextView
        android:id="@+id/tvFechaHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_fecha_pill"
        android:text="Hoy"
        android:textSize="11sp"
        android:textColor="#1AB99F"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"/>

    <!-- Burbuja del mensaje -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_received"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:minWidth="60dp">
        <!--
            bg_bubble_received.xml:
            <shape android:shape="rectangle">
              <solid android:color="#FFFFFF"/>
              <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp"/>
              <stroke android:width="1dp" android:color="#E8F6F3"/>
            </shape>
        -->

        <!-- Contenido del mensaje -->
        <TextView
            android:id="@+id/tvContenido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje recibido"
            android:textSize="15sp"
            android:textColor="#1A2E2B"
            android:lineSpacingExtra="2dp"/>

        <!-- Hora — siempre visible -->
        <TextView
            android:id="@+id/tvHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="12:30"
            android:textSize="10sp"
            android:textColor="#99B8B4"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>