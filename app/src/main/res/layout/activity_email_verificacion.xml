<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondomoviflexx">

    <!-- FONDO ANIMADO -->
    <com.arlys.moviflexx.views.BubbleView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <!-- LOGO -->
            <ImageView
                android:layout_width="136dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/logomo" />

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Crear cuenta"
                android:textColor="#00CED1"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- SUBTÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="verifica tu correo electrónico"
                android:textColor="#666666"
                android:textSize="14sp"
                android:textAlignment="center"
                android:layout_marginBottom="32dp"/>

            <!-- ICONO CORREO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📧"
                android:textSize="56sp"
                android:layout_marginBottom="24dp"/>

            <!-- CAMPO EMAIL -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email_verificacion"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correo electrónico"
                app:errorEnabled="true"
                app:boxBackgroundColor="#FAFAFC"
                app:boxStrokeColor="#2EC4B6"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#6FAFB0"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_email_verificacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#2B2B2B"
                    android:textSize="15sp"
                    android:padding="14dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- INFO BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/info_box_background"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="ℹ️"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Te enviaremos un código de 6 dígitos a este correo para verificar tu identidad."
                    android:textColor="#555555"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- BOTÓN ENVIAR OTP -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enviar_otp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Enviar código de verificación"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_login"
                app:cornerRadius="22dp"
                app:elevation="6dp"
                app:backgroundTint="@null"
                app:rippleColor="#80FFFFFF"
                android:stateListAnimator="@null"/>

            <!-- IR A LOGIN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ir_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¿Ya tienes cuenta? Inicia sesión"
                android:textColor="#2EC4B6"
                android:textStyle="bold"
                style="@style/Widget.Material3.Button.TextButton"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>