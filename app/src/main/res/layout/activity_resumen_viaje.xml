<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ════════════════════════════════════════════════════
         HEADER — teal sólido con card hero
    ════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_resumen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#00CED1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"
                android:alpha="0.15"
                android:background="@drawable/bg_glow_circle_teal"
                android:clickable="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Fila top: back + título + loader -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btn_back_resumen"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_icon_circle_white_alpha"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="#FFFFFF"
                            android:contentDescription="Volver"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOVIFLEX"
                            android:textColor="#CCFFFE"
                            android:textSize="10sp"
                            android:letterSpacing="0.22"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resumen del viaje"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/loader_resumen"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- CARD HERO — total ganado -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_total_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Imagen carro — visible en el resumen final del viaje -->
                        <ImageView
                            android:layout_width="160dp"
                            android:layout_height="90dp"
                            android:src="@drawable/moviflesx"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:alpha="0.85"
                            android:layout_marginBottom="16dp"
                            android:contentDescription="MoviFlexx vehículo"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:letterSpacing="0.18"
                            android:text="TOTAL GANADO EN ESTE VIAJE"
                            android:textColor="#00CED1"
                            android:textSize="9sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_marginBottom="6dp"
                                android:text="$"
                                android:textColor="#00CED1"
                                android:textSize="22sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txt_total_ganado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#1A2F4A"
                                android:textSize="48sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="16dp"
                            android:letterSpacing="0.12"
                            android:text="COP"
                            android:textColor="#7A9BAA"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <!-- Stats: pagados / pendientes / total -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card_teal_subtle"
                                android:gravity="center" android:orientation="vertical"
                                android:paddingStart="8dp" android:paddingTop="10dp"
                                android:paddingEnd="8dp" android:paddingBottom="10dp">
                                <TextView android:id="@+id/txt_count_pagados"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0" android:textColor="#1A2F4A"
                                    android:textSize="22sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Pagados" android:textColor="#00CED1"
                                    android:textSize="11sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <View android:layout_width="1dp" android:layout_height="40dp"
                                android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                                android:background="#D0ECEC"/>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card_teal_subtle"
                                android:gravity="center" android:orientation="vertical"
                                android:paddingStart="8dp" android:paddingTop="10dp"
                                android:paddingEnd="8dp" android:paddingBottom="10dp">
                                <TextView android:id="@+id/txt_count_pendientes"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0" android:textColor="#E65100"
                                    android:textSize="22sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Pendientes" android:textColor="#BF360C"
                                    android:textSize="11sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <View android:layout_width="1dp" android:layout_height="40dp"
                                android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                                android:background="#D0ECEC"/>

                            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card_teal_subtle"
                                android:gravity="center" android:orientation="vertical"
                                android:paddingStart="8dp" android:paddingTop="10dp"
                                android:paddingEnd="8dp" android:paddingBottom="10dp">
                                <TextView android:id="@+id/txt_count_total"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="0" android:textColor="#1565C0"
                                    android:textSize="22sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Pasajeros" android:textColor="#0D47A1"
                                    android:textSize="11sp" android:textStyle="bold"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/header_resumen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp">

            <!-- Card tabla pagos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tabla_pagos"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF" app:strokeColor="#D0ECEC" app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <View android:layout_width="4dp" android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>
                        <TextView android:text="PAGOS POR PASAJERO" android:textSize="10sp"
                            android:textStyle="bold" android:textColor="#00CED1"
                            android:letterSpacing="0.14" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/chip_total_tabla" android:text="0 pagos"
                            android:textSize="11sp" android:textStyle="bold" android:textColor="#00868A"
                            android:background="@drawable/bg_card_teal_subtle"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_card_teal_subtle"
                        android:paddingStart="12dp" android:paddingEnd="12dp">
                        <TextView android:text="Pasajero" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="#00868A"
                            android:layout_width="0dp" android:layout_weight="2.5"
                            android:layout_height="wrap_content"/>
                        <TextView android:text="Método" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="#00868A"
                            android:layout_width="0dp" android:layout_weight="1.5"
                            android:layout_height="wrap_content" android:gravity="center"/>
                        <TextView android:text="Monto" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="#00868A"
                            android:layout_width="0dp" android:layout_weight="1.5"
                            android:layout_height="wrap_content" android:gravity="center"/>
                        <TextView android:text="Estado" android:textSize="11sp"
                            android:textStyle="bold" android:textColor="#00868A"
                            android:layout_width="0dp" android:layout_weight="1.5"
                            android:layout_height="wrap_content" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/layout_filas_pagos"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <LinearLayout android:id="@+id/layout_empty_tabla"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:padding="24dp" android:visibility="gone">
                        <TextView android:text="Sin pagos registrados" android:textSize="14sp"
                            android:textColor="#7A9BAA" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:gravity="center"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card desglose -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_desglose"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" android:visibility="gone"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF" app:strokeColor="#D0ECEC" app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <View android:layout_width="4dp" android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>
                        <TextView android:text="DESGLOSE POR MÉTODO" android:textSize="10sp"
                            android:textStyle="bold" android:textColor="#00CED1"
                            android:letterSpacing="0.14" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/row_efectivo"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_option_selector">
                        <TextView android:text="💵" android:textSize="22sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:text="Efectivo" android:textColor="#1A2F4A"
                                android:textSize="14sp" android:textStyle="bold"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/txt_efectivo_count" android:text="0 pasajeros"
                                android:textColor="#7A9BAA" android:textSize="11sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <TextView android:id="@+id/txt_efectivo_total" android:text="$0"
                            android:textColor="#1A2F4A" android:textSize="16sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/row_transferencia"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:background="@drawable/bg_option_selector">
                        <TextView android:text="📲" android:textSize="22sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:text="Transferencia" android:textColor="#1A2F4A"
                                android:textSize="14sp" android:textStyle="bold"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/txt_transferencia_count" android:text="0 pasajeros"
                                android:textColor="#7A9BAA" android:textSize="11sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <TextView android:id="@+id/txt_transferencia_total" android:text="$0"
                            android:textColor="#1A2F4A" android:textSize="16sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card calificar nota -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calificar_nota"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="14dp" android:visibility="gone"
                app:cardCornerRadius="20dp" app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF8E1" app:strokeColor="#FFE082" app:strokeWidth="1.5dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
                    <TextView android:text="⭐" android:textSize="28sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:text="¡Califica a tus pasajeros!" android:textColor="#5D4037"
                            android:textSize="14sp" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Ayuda a la comunidad calificando el comportamiento de cada pasajero."
                            android:textColor="#795548" android:textSize="12sp"
                            android:lineSpacingMultiplier="1.3"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón calificar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_calificar_pasajeros"
                android:text="CALIFICAR PASAJEROS"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginBottom="10dp" android:visibility="gone"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
                android:letterSpacing="0.04" android:insetTop="0dp" android:insetBottom="0dp"
                app:cornerRadius="14dp" app:backgroundTint="#FF9800"
                app:icon="@android:drawable/star_on" app:iconGravity="textStart"
                app:iconPadding="8dp" app:iconTint="#FFFFFF"/>

            <!-- Botón volver inicio -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_volver_inicio"
                android:text="VOLVER AL INICIO"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
                android:letterSpacing="0.04" android:insetTop="0dp" android:insetBottom="0dp"
                app:backgroundTint="#00CED1" app:cornerRadius="14dp"
                app:elevation="4dp" app:rippleColor="#40FFFFFF"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>