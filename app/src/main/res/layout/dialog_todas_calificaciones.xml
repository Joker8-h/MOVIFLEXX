<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER turquesa -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_header_turquesa"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_dialog_cal_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btn_dialog_close_cal"
                android:text="Todas mis calificaciones"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:layout_centerVertical="true"/>

            <ImageView
                android:id="@+id/btn_dialog_close_cal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_circle_white_alpha"
                android:padding="8dp"
                android:contentDescription="Cerrar"/>
        </RelativeLayout>

        <!-- LISTA scrollable -->
        <android.widget.ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="480dp">

            <LinearLayout
                android:id="@+id/layout_dialog_cal_lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
        </android.widget.ScrollView>

        <!-- BOTÓN cerrar -->
        <TextView
            android:id="@+id/btn_dialog_cerrar_cal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="Cerrar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_btn_turquesa_filled"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>