<?xml version="1.0" encoding="utf-8"?>
<!--
    item_calificacion_pendiente.xml
    Coloca en: res/layout/item_calificacion_pendiente.xml
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#FFE082"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Avatar circular con inicial -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            app:cardBackgroundColor="#FFA726"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_inicial_pasajero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="P"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre + info viaje -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nombre_pasajero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pasajero"
                android:textColor="@color/gray_900"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_car"
                    android:contentDescription="Viaje"
                    app:tint="#9E9E9E"/>

                <TextView
                    android:id="@+id/tv_viaje_pendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viaje #0"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Botón calificar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_calificar_pendiente"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Calificar"
            android:textSize="12sp"
            android:textColor="#2EC4B6"
            app:cornerRadius="18dp"
            app:strokeColor="#2EC4B6"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_star_filled_gold"
            app:iconSize="14dp"
            app:iconTint="#2EC4B6"
            app:iconGravity="textStart"
            app:iconPadding="4dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>