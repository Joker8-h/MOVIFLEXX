<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ════════════════════════════════════════
         BOTTOM NAVIGATION
    ════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/BottomNav.Moviflexx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:elevation="16dp"
        app:menu="@menu/bottom_navigation_menu" />

    <!-- ════════════════════════════════════════
         HEADER
    ════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="237dp"
            android:background="@drawable/fondooomoviflex"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="36dp"
            android:paddingEnd="22dp"
            android:paddingBottom="0dp">

            <!-- Blob decorativo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <View
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="-40dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_glow_circle_teal"
                    android:clickable="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ── Fila: Back + Avatar + Título | Badge + Campana ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Botón atrás -->
                        <FrameLayout
                            android:id="@+id/btnBack"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_icon_circle_white_alpha"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Volver"
                                android:src="@drawable/ic_arrow_back"
                                app:tint="#2C3E50" />
                        </FrameLayout>

                        <!-- ── Avatar: foto encima, inicial debajo ── -->
                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="12dp">

                            <!-- Inicial (visible por defecto) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardAvatarInicial"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:visibility="visible"
                                app:cardBackgroundColor="#00CED1"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="2dp"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/tvInicialUsuario"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="C"
                                    android:textColor="#FFFFFF"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Foto de perfil (oculta hasta que cargue) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardAvatarFoto"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:visibility="gone"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="2dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:id="@+id/ivAvatarFoto"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto perfil"
                                    android:scaleType="centerCrop" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <!-- Títulos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.18"
                                android:text="MOVIFLEX"
                                android:textColor="#00CED1"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="-0.01"
                                android:text="Mensajes"
                                android:textColor="#1A2F4A"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Badge no leídos -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/badgeNoLeidos"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="10dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="#1EFFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#40FFFFFF"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/txtNoLeidos"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:minWidth="28dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Campana -->
                        <FrameLayout
                            android:id="@+id/btnNotificaciones"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_icon_circle_white_alpha"
                            android:backgroundTint="#00CED1"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Notificaciones"
                                android:src="@drawable/ic_notifications"
                                app:tint="#FFFFFF" />

                            <View
                                android:id="@+id/dotNotificacion"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/bg_badge_red"
                                android:visibility="gone" />
                        </FrameLayout>

                    </LinearLayout>

                    <!-- ── BUSCADOR ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_btn_white_rounded"
                        android:elevation="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Buscar"
                            android:src="@drawable/ic_search"
                            app:tint="#00CED1" />

                        <EditText
                            android:id="@+id/etBuscar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Buscar conversación..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#1A2F4A"
                            android:textColorHint="#A0BEC0"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- ── CHIPS DE FILTRO ── -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:paddingBottom="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipTodos"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_chip_selected"
                                android:gravity="center"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:text="Todos"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/chipNoLeidos"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:text="No leídos"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/chipFavoritos"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:gravity="center"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:text="Favoritos"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ════════════════════════════════════════
         SWIPE REFRESH + LISTA
    ════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F0FAFA">

            <!-- RecyclerView conversaciones -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConversaciones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- ════════════════════════════
                 EMPTY STATE
            ════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tvSinResultados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="40dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#E0FFFE"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="Sin mensajes"
                        android:src="@android:drawable/ic_dialog_email" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Sin conversaciones"
                    android:textColor="#1A2F4A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEmptySubtitle"
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Los chats aparecerán aquí cuando reserves un viaje"
                    android:textColor="#7A9BAA"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ════════════════════════════
                 OVERLAY DE CARGA
            ════════════════════════════ -->
            <LinearLayout
                android:id="@+id/loadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0FAFA"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivLoadingAnim"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:contentDescription="Cargando"
                        android:src="@drawable/ic_loading_moviflexx" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.20"
                    android:text="MOVIFLEX"
                    android:textColor="#00CED1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoadingMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando mensajes..."
                    android:textColor="#7A9BAA"
                    android:textSize="13sp" />

            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>