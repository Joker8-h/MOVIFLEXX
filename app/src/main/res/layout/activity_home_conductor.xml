<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/header_background_green"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Profile -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/circle_background_yellow"
                android:padding="2dp"
                android:src="@drawable/ic_profile_placeholder" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Conductor"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/role_driver"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MENU CONTAINER -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- INICIO -->
            <LinearLayout
                android:id="@+id/menuHome"
                style="@style/MenuItemStyle">
                <ImageView style="@style/MenuIconStyle" android:src="@drawable/ic_home" app:tint="@color/purple_primary"/>
                <TextView style="@style/MenuTextStyle" android:text="Inicio"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- VIAJES ACTIVOS -->
            <LinearLayout
                android:id="@+id/menuActiveTrips"
                style="@style/MenuItemStyle">
                <ImageView style="@style/MenuIconStyle" android:src="@drawable/ic_car" app:tint="@color/purple_primary"/>
                <TextView style="@style/MenuTextStyle" android:text="Viajes Activos"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- HISTORIAL -->
            <LinearLayout
                android:id="@+id/menuHistory"
                style="@style/MenuItemStyle">
                <ImageView style="@style/MenuIconStyle" android:src="@drawable/ic_history" app:tint="@color/purple_primary"/>
                <TextView style="@style/MenuTextStyle" android:text="Historial de Viajes"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- MI VEHÍCULO -->
            <LinearLayout
                android:id="@+id/menuVehicle"
                style="@style/MenuItemStyle">
                <ImageView style="@style/MenuIconStyle" android:src="@drawable/ic_vehicle" app:tint="@color/purple_primary"/>
                <TextView style="@style/MenuTextStyle" android:text="Mi Vehículo"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- GANANCIAS -->
            <LinearLayout
                android:id="@+id/menuEarnings"
                style="@style/MenuItemStyle">
                <ImageView style="@style/MenuIconStyle" android:src="@drawable/ic_money" app:tint="@color/purple_primary"/>
                <TextView style="@style/MenuTextStyle" android:text="Ganancias"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- CONFIGURACIÓN -->
            <LinearLayout
                android:id="@+id/menuSettings"
                style="@style/MenuItemStyle">
                <ImageView style="@style/MenuIconStyle" android:src="@drawable/ic_settings" app:tint="@color/purple_primary"/>
                <TextView style="@style/MenuTextStyle" android:text="Configuración"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
