<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ════════════════════════════════════════════════════
         BOTTOM NAVIGATION
    ════════════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/BottomNav.Moviflexx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:elevation="16dp"
        app:menu="@menu/bottom_navigation_menu" />

    <!-- ════════════════════════════════════════════════════
         APP BAR — HEADER
    ════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="297dp"
            android:background="@drawable/fondooomoviflex"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="36dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <!-- Blob decorativo -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-50dp"
                    android:layout_marginEnd="-50dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_glow_circle_teal"
                    android:clickable="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ── Fila: Avatar + Saludo + Campana ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Avatar -->

                        <FrameLayout
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="14dp">


                            <!-- Card inicial (logo, visible por defecto) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_avatar_inicial_header"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="4dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Logo"
                                    android:src="@drawable/logomo" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Card foto real Cloudinary (oculta por defecto) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_avatar_foto_header"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:visibility="gone"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="4dp"
                                app:strokeColor="#FFFFFF"
                                app:strokeWidth="1.5dp">

                                <ImageView
                                    android:id="@+id/iv_avatar_header"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de perfil"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>


                        </FrameLayout>

                        <!-- Saludo -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_bienvenida"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="Buenos días,"
                                android:textColor="#1A2F4A"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txt_nombre_conductor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Conductor"
                                android:textColor="#1A2F4A"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Campana -->
                        <FrameLayout
                            android:id="@+id/btn_notificaciones"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_icon_circle_white_alpha"
                            android:backgroundTint="#00CED1"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="Notificaciones"
                                android:src="@drawable/ic_notifications"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/tv_badge_notif"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_badge_red"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                    </LinearLayout>

                    <!-- ── BOTÓN PUBLICAR ── -->
                    <FrameLayout
                        android:id="@+id/btn_publicar_viaje"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_btn_white_rounded"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="false"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="10dp"
                                android:contentDescription="Publicar"
                                android:src="@drawable/ic_add"
                                app:tint="#00CED1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:letterSpacing="0.06"
                                android:text="PUBLICAR NUEVO VIAJE"
                                android:textColor="#00CED1"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- ── CARDS: Mis Rutas + Vehículos ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Card Mis Rutas -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_mis_rutas"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_marginEnd="7dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#1EFFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#50FFFFFF"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="10dp">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/bg_icon_circle_white_alpha">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Rutas"
                                        android:src="@drawable/ic_menu_compass"
                                        app:tint="#00CED1" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mis Rutas"
                                        android:textColor="#FFFFFF"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ver todas →"
                                        android:textColor="#00CED1"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card Mis Vehículos -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_mis_vehiculos"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#1EFFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#50FFFFFF"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="10dp">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/bg_icon_circle_white_alpha">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Vehículos"
                                        android:src="@drawable/ic_car"
                                        app:tint="#00CED1" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Vehículos"
                                        android:textColor="#FFFFFF"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Administrar →"
                                        android:textColor="#00CED1"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ════════════════════════════════════════════════════
         CONTENIDO SCROLLABLE
    ════════════════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F0FAFA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="100dp">

                <!-- ════════════════════════════════════════════
                     CALIFICACIONES PENDIENTES
                ════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/layout_calificaciones_pendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_star_filled_gold"
                            android:contentDescription="Calificaciones" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Calificaciones pendientes"
                            android:textColor="#1A2F4A"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_calificaciones_pendientes"
                            style="@style/Chip.Moviflexx.Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipBackgroundColor="#FFF3E0"
                            android:textColor="#E65100"
                            android:text="0 pendientes"/>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#FFF8E1"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#FFE082"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="12dp"
                                android:src="@drawable/ic_star_filled_gold"
                                android:contentDescription="Aviso"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tienes pasajeros de viajes finalizados que esperan tu calificación."
                                android:textColor="#5D4037"
                                android:textSize="13sp"
                                android:lineSpacingMultiplier="1.3"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_calificaciones_pendientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"/>

                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:id="@+id/divider_calificaciones"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#D0ECEC"
                    android:visibility="gone"/>

                <!-- ════════════════════════════════════════════
                     ENCABEZADO VIAJES
                ════════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_line_teal_rounded"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Viajes publicados"
                        android:textColor="#1A2F4A"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_total"
                        style="@style/Chip.Moviflexx.Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="#E0FFFE"
                        android:textColor="#00868A"
                        android:text="0 activos"/>
                </LinearLayout>

                <!-- ProgressBar -->
                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:indeterminateTint="#00CED1"
                    android:layout_marginTop="32dp"
                    android:visibility="gone"/>

                <!-- RecyclerView viajes -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_viajes_activos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"/>

                <!-- ════════════════════════════════════════════
                     EMPTY STATE — aquí sí aparece el carro
                     Solo visible cuando no hay viajes publicados
                ════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/layout_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="32dp"
                    android:paddingBottom="48dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:visibility="gone">

                    <!-- Imagen del carro — solo aquí tiene sentido -->
                    <ImageView
                        android:layout_width="240dp"
                        android:layout_height="140dp"
                        android:src="@drawable/moviflesx"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginBottom="24dp"
                        android:alpha="0.85"
                        android:contentDescription="Sin viajes"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No tienes viajes activos"
                        android:textColor="#1A2F4A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Publica tu primer viaje y empieza&#10;a conectar con pasajeros"
                        android:textColor="#7A9BAA"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="28dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_publicar_empty"
                        android:layout_width="220dp"
                        android:layout_height="52dp"
                        android:text="Publicar ahora"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#00CED1"
                        app:cornerRadius="26dp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:iconTint="#FFFFFF"
                        app:elevation="4dp"
                        app:rippleColor="#40FFFFFF"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>