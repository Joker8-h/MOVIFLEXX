<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/header_background_green"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status Bar -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_signal"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10:30 AM"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_battery"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/circle_background_yellow"
                android:padding="2dp"
                android:src="@drawable/ic_profile_placeholder" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lorem ipsum Name"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/role_client"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MENU CARD -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- INICIO -->
            <LinearLayout
                android:id="@+id/menuHome"
                style="@style/MenuItemStyle">

                <ImageView
                    style="@style/MenuIconStyle"
                    android:src="@drawable/ic_home"
                    app:tint="@color/purple_primary"/>

                <TextView
                    style="@style/MenuTextStyle"
                    android:text="@string/menu_home"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- MIS VIAJES -->
            <LinearLayout
                android:id="@+id/menuMyTrips"
                style="@style/MenuItemStyle">

                <ImageView
                    style="@style/MenuIconStyle"
                    android:src="@drawable/ic_trips"
                    app:tint="@color/purple_primary"/>

                <TextView
                    style="@style/MenuTextStyle"
                    android:text="@string/menu_my_trips"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- NOTIFICACIONES -->
            <LinearLayout
                android:id="@+id/menuNotifications"
                style="@style/MenuItemStyle">

                <ImageView
                    style="@style/MenuIconStyle"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/purple_primary"/>

                <TextView
                    style="@style/MenuTextStyle"
                    android:text="@string/menu_notifications"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- MÉTODOS DE PAGO -->
            <LinearLayout
                android:id="@+id/menuPayment"
                style="@style/MenuItemStyle">

                <ImageView
                    style="@style/MenuIconStyle"
                    android:src="@drawable/ic_payment"
                    app:tint="@color/purple_primary"/>

                <TextView
                    style="@style/MenuTextStyle"
                    android:text="@string/menu_payment"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- CONFIGURACIÓN -->
            <LinearLayout
                android:id="@+id/menuSettings"
                style="@style/MenuItemStyle">

                <ImageView
                    style="@style/MenuIconStyle"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/purple_primary"/>

                <TextView
                    style="@style/MenuTextStyle"
                    android:text="@string/menu_settings"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
