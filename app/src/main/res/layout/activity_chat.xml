<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF9F7">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#9FE0D8"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:elevation="4dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icon_circle_white_alpha"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"/>
        </FrameLayout>
        <!-- ════════════════════════════════════════════
             AVATAR — foto real o inicial de fallback
        ════════════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp">

            <!-- Inicial (visible por defecto) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mi_inicial_chat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvAvatarHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="C"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1AB99F"
                    android:background="@drawable/bg_circle_teal_dark"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Foto real Cloudinary (oculta por defecto) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mi_foto_chat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="gone"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/iv_mi_foto_chat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Mi foto de perfil"/>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvNombreChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conductor"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <View
                    android:id="@+id/dotEstado"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/circle_offline"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#CCF5F1"/>
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenuOpciones"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones"
            app:tint="#FFFFFF"
            android:padding="6dp"/>
    </LinearLayout>

    <!-- LISTA DE MENSAJES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:overScrollMode="never"
        android:background="#EEF9F7"/>

    <!-- PANEL SUGERENCIAS -->
    <LinearLayout
        android:id="@+id/panel_sugerencias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D8F5EF"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#A8EDE4"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingTop="7dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💬 Sugerencias rápidas"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0D8C77"/>

            <ImageButton
                android:id="@+id/btn_cerrar_sugerencias"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar sugerencias"
                android:alpha="0.5"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_sugerencias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacingHorizontal="6dp"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- PANEL GRABACIÓN ESTILO WHATSAPP -->
    <LinearLayout
        android:id="@+id/panelGrabacion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="6dp"
        android:visibility="gone">

        <View
            android:id="@+id/dotGrabando"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_offline"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvTiempoGrabacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:layout_marginEnd="20dp"/>

        <TextView
            android:id="@+id/tvDeslizarCancelar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀  Desliza para cancelar"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:gravity="center"/>

    </LinearLayout>

    <!-- BARRA DE INPUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnAudio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/bg_circle_white_semi"
            android:contentDescription="Grabar audio"
            android:padding="10dp"
            app:tint="#1AB99F"
            android:visibility="visible"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            app:boxCornerRadiusTopStart="26dp"
            app:boxCornerRadiusTopEnd="26dp"
            app:boxCornerRadiusBottomStart="26dp"
            app:boxCornerRadiusBottomEnd="26dp"
            app:boxStrokeColor="@color/box_stroke_color"
            app:boxBackgroundColor="#F5FFFE"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Escribe un mensaje..."
                android:textColorHint="#99C8C2"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:textSize="15sp"
                android:textColor="#1A3835"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@null"/>
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/btnEnviar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/circle_send_button"
            android:contentDescription="Enviar"
            android:padding="11dp"
            android:enabled="false"
            android:alpha="0.35"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>