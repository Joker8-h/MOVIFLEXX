<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F8F8">

    <!-- ══════════════════════════════════════════
         HEADER
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_buscar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#00897B"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Buscar Viaje"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingresa tu origen y te mostramos los viajes disponibles"
            android:textColor="#B2DFDB"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- ══════════════════════════════════════════
         SCROLL PRINCIPAL
         ══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/header_buscar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════════════════════════════════
                 CARD DE BÚSQUEDA
                 ══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Indicador visual origen → destino -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <LinearLayout
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginEnd="12dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_teal"
                                android:layout_gravity="center_horizontal"/>

                            <View
                                android:layout_width="2dp"
                                android:layout_height="32dp"
                                android:background="#80B2DFDB"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="3dp"
                                android:layout_marginBottom="3dp"/>

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center_horizontal"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- CAMPO ORIGEN (obligatorio) -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="¿Dónde estás? (Origen *)"
                                app:boxStrokeColor="#00BCD4"
                                app:hintTextColor="#00ACC1"
                                app:boxStrokeWidth="2dp"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxBackgroundColor="#E0F2F1"
                                app:startIconDrawable="@android:drawable/ic_menu_mylocation"
                                app:startIconTint="#00ACC1"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_origen_pasajero"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:imeOptions="actionNext"
                                    android:hint="Ej: Carrera 5 con Calle 10"
                                    android:textColor="#004D40"
                                    android:textSize="14sp"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- CAMPO DESTINO (opcional) -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:hint="¿A dónde vas? (Opcional)"
                                app:boxStrokeColor="#EF5350"
                                app:hintTextColor="#E57373"
                                app:boxStrokeWidth="2dp"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxBackgroundColor="#FFF8F8"
                                app:startIconDrawable="@android:drawable/ic_dialog_map"
                                app:startIconTint="#EF5350"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_destino_pasajero"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:imeOptions="actionSearch"
                                    android:hint="Ej: Terminal de transporte"
                                    android:textColor="#004D40"
                                    android:textSize="14sp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Info de radio de búsqueda -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:text="📡 Buscaremos viajes en un radio de 1 km desde tu origen"
                        android:textSize="12sp"
                        android:textColor="#90A4AE"
                        android:gravity="center"/>

                    <!-- BOTÓN BUSCAR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buscar_viajes"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="🔍  BUSCAR VIAJES CERCANOS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#00897B"
                        app:elevation="4dp"/>

                    <!-- LOADER -->
                    <ProgressBar
                        android:id="@+id/loader_buscar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        android:indeterminateTint="#00897B"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════
                 MAPA MINI
                 ══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/map_buscar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:clickable="true"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════
                 TÍTULO RESULTADOS
                 ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="#00897B"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Viajes disponibles cerca de ti"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#004D40"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 En vivo"
                    android:textSize="11sp"
                    android:textColor="#00897B"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ══════════════════════════════════════════
                 TEXTO VACÍO
                 ══════════════════════════════════════════ -->
            <TextView
                android:id="@+id/txt_resultado_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:gravity="center"
                android:padding="24dp"
                android:text="Ingresa tu ubicación para encontrar viajes 🗺️"
                android:textSize="14sp"
                android:textColor="#90A4AE"
                android:lineSpacingExtra="4dp"/>

            <!-- ══════════════════════════════════════════
                 CONTENEDOR DE RESULTADOS (cards dinámicas)
                 ══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layout_resultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>