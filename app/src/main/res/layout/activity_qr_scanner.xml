<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  FONDO: Preview de la cámara                              -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/qr_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  OVERLAY OSCURO (vignette) encima de la cámara           -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  HEADER — título + botón volver                          -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_qr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón volver -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_volver_login_qr"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text=""
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="#FFFFFF"
            app:iconSize="24dp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="22dp" />

        <!-- Título -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Escanear código QR"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />

        <!-- Espacio para balancear el botón de la izquierda -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  SUBTÍTULO                                                -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/txt_subtitulo_qr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apunta la cámara al código QR de acceso"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/header_qr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  MARCO DE ESCANEO QR                                      -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qr_marco"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toBottomOf="@id/txt_subtitulo_qr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fondo semi-transparente dentro del marco -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#18FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Esquinas decorativas (4 esquinas en L) ── -->

        <!-- Esquina Superior Izquierda -->
        <View android:id="@+id/corner_tl_h"
            android:layout_width="36dp" android:layout_height="4dp"
            android:background="#2EC4B6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <View android:id="@+id/corner_tl_v"
            android:layout_width="4dp" android:layout_height="36dp"
            android:background="#2EC4B6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Esquina Superior Derecha -->
        <View android:id="@+id/corner_tr_h"
            android:layout_width="36dp" android:layout_height="4dp"
            android:background="#2EC4B6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <View android:id="@+id/corner_tr_v"
            android:layout_width="4dp" android:layout_height="36dp"
            android:background="#2EC4B6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Esquina Inferior Izquierda -->
        <View android:id="@+id/corner_bl_h"
            android:layout_width="36dp" android:layout_height="4dp"
            android:background="#2EC4B6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <View android:id="@+id/corner_bl_v"
            android:layout_width="4dp" android:layout_height="36dp"
            android:background="#2EC4B6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Esquina Inferior Derecha -->
        <View android:id="@+id/corner_br_h"
            android:layout_width="36dp" android:layout_height="4dp"
            android:background="#2EC4B6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <View android:id="@+id/corner_br_v"
            android:layout_width="4dp" android:layout_height="36dp"
            android:background="#2EC4B6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Línea de escaneo animada ── -->
        <View
            android:id="@+id/qr_scan_line"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@drawable/qr_scan_line_gradien"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  PISTA DEBAJO DEL MARCO                                   -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_pista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#33000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/qr_marco"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu código QR expira en 3 horas"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  CARD ESTADO (cargando / error / éxito)                   -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_estado_qr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnQrLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txt_estado_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text=""
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  BOTÓN VOLVER AL LOGIN (abajo)                            -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQrLogin"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="32dp"
        android:onClick="login"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="40dp"
        android:text="← Volver al inicio de sesión"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1.5dp"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!--  OVERLAY ÉXITO (aparece al loguearse)                     -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/overlay_exito_qr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Círculo verde con check -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅"
            android:textSize="72sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txt_nombre_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Hola!"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/txt_rol_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#2EC4B6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#332EC4B6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceso verificado 🎉"
            android:textColor="#AAFFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>