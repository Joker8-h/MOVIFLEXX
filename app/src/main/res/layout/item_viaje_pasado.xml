<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header con nombre y estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/primary_blue">

                <ImageView
                    android:id="@+id/img_icono_viaje"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_location_marker"
                    android:contentDescription="@string/viaje"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_nombre_viaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Viaje a Oficina Central"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_fecha_viaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 marzo, 2023 - 23:48"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/completado"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/status_completed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_status_chip"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Ruta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Indicadores visuales -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_origin_dot"
                    android:tint="@color/accent_coral"
                    android:contentDescription="@string/origen"/>

                <View
                    android:layout_width="2dp"
                    android:layout_height="32dp"
                    android:background="@color/border_light"
                    android:layout_marginVertical="4dp"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_destination_dot"
                    android:tint="@color/primary_blue"
                    android:contentDescription="@string/destino"/>
            </LinearLayout>

            <!-- Direcciones -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_origen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Av. Insurgentes Sur 1402"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_destino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Torre Reforma 222"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="24dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginBottom="12dp"/>

        <!-- Precio y rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_precio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="$2,000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"/>

            <!-- Rating -->
            <LinearLayout
                android:id="@+id/layout_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="@string/calificacion"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/calificacion"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/calificacion"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/calificacion"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/calificacion"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón ver detalles -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ver_detalles"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/ver_detalles"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="2dp"
            android:layout_marginTop="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
