<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_white"
        android:paddingBottom="32dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_handle_gray"/>

        <!-- ══════════════════════════════════════════════
             CABECERA: título + AVATAR del calificado
        ══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <!-- Título con ícono -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_circle_teal_sm">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="⭐"
                        android:textSize="16sp"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/txtTituloSheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Califica al conductor"
                        android:textSize="17sp"
                        android:textColor="#1A2F4A"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtSubtituloSheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="¿Cómo fue tu experiencia?"
                        android:textSize="12sp"
                        android:textColor="#7A9BAA"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── AVATAR del calificado ── -->
            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp">


                <!-- Card con FOTO real (Cloudinary) — visible cuando hay URL -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatarFotoSheet"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    app:cardCornerRadius="39dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#00CED1"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/ivAvatarSheet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto del usuario"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card con INICIAL (fallback) — visible cuando no hay foto -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatarInicialSheet"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:visibility="visible"
                    app:cardBackgroundColor="#E0FFFE"
                    app:cardCornerRadius="39dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#00CED1"
                    app:strokeWidth="2dp">

                    <TextView
                        android:id="@+id/tvInicialSheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textSize="30sp"
                        android:textColor="#00868A"
                        android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Nombre del calificado debajo del avatar -->
            <TextView
                android:id="@+id/tvNombreCalificadoSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Nombre"
                android:textSize="15sp"
                android:textColor="#1A2F4A"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <!-- Rol: "Conductor" o "Pasajero" -->
            <TextView
                android:id="@+id/tvRolCalificadoSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Conductor"
                android:textSize="11sp"
                android:textColor="#1A2F4A"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_chip_teal"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF5F5"
            android:layout_marginTop="8dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"/>

        <!-- ══════════════════════════════════════════════
             ESTRELLAS
        ══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutEstrellas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:clipChildren="false"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp"
            android:padding="4dp">

            <ImageView android:id="@+id/star1"
                android:layout_width="54dp" android:layout_height="54dp" android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy" android:scaleType="centerInside"
                android:contentDescription="1 estrella" android:background="@android:color/transparent"/>
            <ImageView android:id="@+id/star2"
                android:layout_width="54dp" android:layout_height="54dp" android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy" android:scaleType="centerInside"
                android:contentDescription="2 estrellas" android:background="@android:color/transparent"/>
            <ImageView android:id="@+id/star3"
                android:layout_width="54dp" android:layout_height="54dp" android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy" android:scaleType="centerInside"
                android:contentDescription="3 estrellas" android:background="@android:color/transparent"/>
            <ImageView android:id="@+id/star4"
                android:layout_width="54dp" android:layout_height="54dp" android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy" android:scaleType="centerInside"
                android:contentDescription="4 estrellas" android:background="@android:color/transparent"/>
            <ImageView android:id="@+id/star5"
                android:layout_width="54dp" android:layout_height="54dp" android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy" android:scaleType="centerInside"
                android:contentDescription="5 estrellas" android:background="@android:color/transparent"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtEtiquetaPuntuacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="#00CED1"
            android:textStyle="bold"
            android:gravity="center"
            android:minWidth="160dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF5F5"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="14dp"/>

        <!-- ══════════════════════════════════════════════
             SUGERENCIAS / CHIPS
        ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="8dp"
            android:text="💬  Sugerencias rápidas"
            android:textSize="12sp"
            android:textColor="#7A9BAA"/>

        <HorizontalScrollView
            android:id="@+id/scrollChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none"
            android:visibility="gone"
            android:alpha="0">
            <LinearLayout
                android:id="@+id/layoutChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- ══════════════════════════════════════════════
             COMENTARIO (opcional)
        ══════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/lblComentario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="6dp"
            android:text="Comentario (opcional)"
            android:textSize="12sp"
            android:textColor="#7A9BAA"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilComentario"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:hint="Escribe algo sobre tu experiencia..."
            app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#D0ECEC" app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#F9FAFB" app:hintTextColor="#7A9BAA"
            app:counterEnabled="true" app:counterMaxLength="200">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComentario"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minLines="3" android:maxLines="5" android:maxLength="200"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="14sp" android:textColor="#1A2F4A"
                android:padding="14dp" android:gravity="top"
                android:background="@android:color/transparent"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ══════════════════════════════════════════════
             BOTÓN ENVIAR
        ══════════════════════════════════════════════ -->
        <Button
            android:id="@+id/btnEnviarCalificacion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:text="⭐  ENVIAR CALIFICACIÓN"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.04"
            android:enabled="false"
            android:alpha="0.4"
            android:background="@drawable/bg_btn_login"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <TextView
            android:id="@+id/btnOmitir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Ahora no"
            android:textSize="13sp"
            android:textColor="#7A9BAA"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:clickable="true" android:focusable="true"/>

        <!-- ══════════════════════════════════════════════
             PANEL ÉXITO
        ══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutExito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:alpha="0">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉  ¡Calificación enviada!"
                android:textSize="17sp"
                android:textColor="#00CED1"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Gracias por mejorar la comunidad MoviFlex"
                android:textSize="12sp"
                android:textColor="#7A9BAA"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>