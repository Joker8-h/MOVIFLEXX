<?xml version="1.0" encoding="utf-8"?>
<!--
╔══════════════════════════════════════════════════════════╗
  bottom_sheet_calificar.xml  —  MoviFlexx Premium
  Paleta: Azul oscuro #1A2035 · Turquesa #3DCFC7 · Blanco #FFFFFF · Gris #F4F6F9
  Inspirado en la captura real (imagen 2): limpio, espacioso, profesional
╚══════════════════════════════════════════════════════════╝
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_white"
        android:paddingBottom="32dp">

        <!-- HANDLE -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_handle_gray"/>

        <!-- ════════════════════════════════════════
             TÍTULO
        ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="⭐"
                android:textSize="18sp"
                android:background="@drawable/bg_icon_circle_teal_sm"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtTituloSheet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Califica a tu pasajero"
                    android:textSize="17sp"
                    android:textColor="#1A2035"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/txtSubtituloSheet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="¿Cómo fue tu experiencia con carlos?"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Línea divisora -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="22dp"/>

        <!-- ════════════════════════════════════════
             ESTRELLAS
        ════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutEstrellas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:clipChildren="false"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp"
            android:padding="4dp">

            <ImageView android:id="@+id/star1"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy"
                android:scaleType="centerInside"
                android:contentDescription="1 estrella"
                android:background="@android:color/transparent"/>

            <ImageView android:id="@+id/star2"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy"
                android:scaleType="centerInside"
                android:contentDescription="2 estrellas"
                android:background="@android:color/transparent"/>

            <ImageView android:id="@+id/star3"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy"
                android:scaleType="centerInside"
                android:contentDescription="3 estrellas"
                android:background="@android:color/transparent"/>

            <ImageView android:id="@+id/star4"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy"
                android:scaleType="centerInside"
                android:contentDescription="4 estrellas"
                android:background="@android:color/transparent"/>

            <ImageView android:id="@+id/star5"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_margin="3dp"
                android:src="@drawable/ic_star_empty_navy"
                android:scaleType="centerInside"
                android:contentDescription="5 estrellas"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- Etiqueta puntaje (ej: "😊 Bueno") -->
        <TextView
            android:id="@+id/txtEtiquetaPuntuacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="#3DCFC7"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="160dp"/>

        <!-- Línea divisora suave -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="14dp"/>

        <!-- ════════════════════════════════════════
             SUGERENCIAS RÁPIDAS (chips)
        ════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="8dp"
            android:text="💬  Sugerencias rápidas"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:fontFamily="sans-serif-medium"
            android:visibility="visible"/>

        <HorizontalScrollView
            android:id="@+id/scrollChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none"
            android:visibility="gone"
            android:alpha="0">

            <LinearLayout
                android:id="@+id/layoutChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- ════════════════════════════════════════
             COMENTARIO
        ════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="6dp"
            android:text="Comentario (opcional)"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:fontFamily="sans-serif-medium"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilComentario"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:hint="Escribe algo sobre tu experiencia..."
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#F9FAFB"
            app:hintTextColor="#9CA3AF"
            app:counterEnabled="true"
            app:counterMaxLength="200">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:maxLines="5"
                android:maxLength="200"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="14sp"
                android:textColor="#1A2035"
                android:padding="14dp"
                android:gravity="top"
                android:fontFamily="sans-serif"
                android:background="@android:color/transparent"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ════════════════════════════════════════
             BOTÓN ENVIAR PRINCIPAL (ancho completo, teal)
        ════════════════════════════════════════ -->
        <Button
            android:id="@+id/btnEnviarCalificacion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:text="⭐  ENVIAR CALIFICACIÓN"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:enabled="false"
            android:alpha="0.4"
            android:background="@drawable/bg_btn_login"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <!-- Botón Ahora no (texto centrado, discreto) -->
        <TextView
            android:id="@+id/btnOmitir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Ahora no"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:fontFamily="sans-serif"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- ════════════════════════════════════════
             PANEL ÉXITO (oculto)
        ════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutExito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:alpha="0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉  ¡Calificación enviada!"
                android:textSize="17sp"
                android:textColor="#3DCFC7"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Gracias por mejorar la comunidad MoviFlexx"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>