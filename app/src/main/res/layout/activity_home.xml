<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgLight">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="250dp"
        android:layout_height="200dp"
        android:layout_marginTop="367dp"
        android:layout_marginLeft="80dp">


        <VideoView
            android:id="@+id/backgroundVideo"
            android:layout_width="match_parent"
            android:layout_height="755dp"
            android:layout_weight="1" />


    </LinearLayout>


    <!-- Fondo con curva -->
    <View
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@drawable/home_top_background" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/logoHome"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:src="@drawable/fondomoviflex"
        android:elevation="8dp" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primaryDark"
        android:layout_below="@id/logoHome"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="@string/home_subtitle"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/grayDark"
        android:layout_below="@id/txtTitulo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp" />

    <!-- Botón Siguiente -->
    <Button
        android:id="@+id/btnComenzar"
        android:layout_width="250dp"
        android:onClick="irLogin"
        android:layout_height="55dp"
        android:text="@string/home_next"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="90dp"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:elevation="6dp" />

</RelativeLayout>
