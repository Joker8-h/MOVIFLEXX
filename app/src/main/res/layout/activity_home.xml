<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondomoviflex">

    <!-- ─── Partículas burbuja de fondo ─── -->


    <!-- ─── Aura glow superior izquierda ─── -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:alpha="0.18"
        android:background="@drawable/bg_glow_circle_teal"
        android:clickable="false"/>

    <!-- ─── Aura inferior derecha ─── -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="100dp"
        android:alpha="0.12"
        android:background="@drawable/bg_glow_circle_teal"
        android:clickable="false"/>

    <!-- ════════════════════════════════════════════════════
         CONTENIDO PRINCIPAL
    ════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- ── LOGO ── -->
        <ImageView
            android:id="@+id/logoHome"
            android:layout_width="130dp"
            android:layout_height="105dp"
            android:layout_marginTop="52dp"
            android:contentDescription="@string/app_name"
            android:elevation="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logomo" />

        <!-- ── NOMBRE DE LA APP ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOVIFLEX"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2EC4B6"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.15"
            android:layout_marginTop="-8dp"
            android:elevation="8dp"
            android:shadowColor="#402EC4B6"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="12"/>

        <!-- ── ILUSTRACIÓN FIJA DEL CARRO ── -->
        <ImageView
            android:id="@+id/imgIlustracion"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="24dp"
            android:src="@drawable/moviflesx"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:elevation="6dp"
            android:contentDescription="MoviFlexx ilustración" />
        <!-- ── VIEWPAGER2: carrusel solo con texto y pills ── -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerOnboarding"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"/>

        <!-- ════════════════════════════════════════════════
             ZONA INFERIOR FIJA: dots + botón + skip
        ════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingBottom="40dp">

            <!-- Indicadores de página (dots) -->
            <LinearLayout
                android:id="@+id/dotsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <View android:id="@+id/dot1"
                    android:layout_width="28dp"
                    android:layout_height="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/dot_active"/>

                <View android:id="@+id/dot2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/dot_inactive"/>

                <View android:id="@+id/dot3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/dot_inactive"/>

            </LinearLayout>

            <!-- ══ BOTÓN SHIMMER PRINCIPAL ══ -->
            <FrameLayout
                android:id="@+id/btnComenzar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="14dp"
                android:background="@drawable/bg_btn_container">

                <!-- Gradiente base del botón -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_gradient_teal"
                    android:clickable="false"/>

                <!-- Barra shimmer (animada desde Java) -->
                <View
                    android:id="@+id/shimmerBar"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_shimmer_bar"
                    android:alpha="0.4"
                    android:clickable="false"/>

                <!-- Contenido del botón -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="false">

                    <TextView
                        android:id="@+id/txtBtnLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIGUIENTE"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.10"
                        android:clickable="false"/>

                    <TextView
                        android:id="@+id/txtBtnArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="›"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-light"
                        android:clickable="false"/>

                </LinearLayout>
            </FrameLayout>

            <!-- Skip / Ahora no -->
            <TextView
                android:id="@+id/txtSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ahora no"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>