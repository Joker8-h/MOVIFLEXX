<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#00CED1"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="36dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"
                android:alpha="0.15"
                android:background="@drawable/bg_glow_circle_teal"
                android:clickable="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOVIFLEX"
                        android:textColor="#CCFFFE"
                        android:textSize="10sp"
                        android:letterSpacing="0.18"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mis Reservas"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.01"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Historial de tus viajes reservados"
                        android:textColor="#CCFFFE"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/loader_mis_reservas"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- SCROLL PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_root_mis_reservas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- BANNER BLOQUEO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_bloqueo_busqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF3E0"
                app:strokeColor="#FFB74D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_icon_circle_white_alpha">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🔒"
                            android:textSize="18sp"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="Búsqueda bloqueada"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#E65100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/txt_bloqueo_busqueda"
                            android:text="Ya tienes un viaje activo. Una vez que el conductor finalice podrás buscar uno nuevo."
                            android:textSize="12sp"
                            android:textColor="#BF360C"
                            android:layout_marginTop="3dp"
                            android:lineSpacingMultiplier="1.3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD BUSCAR VIAJE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_publicar_ruta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Busca tu ruta"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#1A2F4A"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Conductores que pasan cerca de ti"
                                android:textSize="12sp"
                                android:textColor="#7A9BAA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Campo ORIGEN -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#00CED1"
                        app:hintTextColor="#00CED1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_origen_pasajero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="¿Desde dónde sales?"
                            android:textSize="14sp"
                            android:textColor="#1A2F4A"
                            android:inputType="textPostalAddress"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- GPS status -->
                    <LinearLayout
                        android:id="@+id/layout_gps_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingBottom="8dp">

                        <ProgressBar
                            android:id="@+id/progress_gps"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:indeterminateTint="#00CED1"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/txt_gps_status"
                            android:text="Obteniendo tu ubicación GPS..."
                            android:textSize="11sp"
                            android:textColor="#7A9BAA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Línea conectora -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:layout_marginBottom="4dp">
                        <View
                            android:layout_width="2dp"
                            android:layout_height="14dp"
                            android:background="#A0E0DC"/>
                    </LinearLayout>

                    <!-- Campo DESTINO -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="#EF5350"
                        app:hintTextColor="#EF5350">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_destino_pasajero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="¿A dónde vas?"
                            android:textSize="14sp"
                            android:textColor="#1A2F4A"
                            android:inputType="textPostalAddress"
                            android:imeOptions="actionSearch"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Sugerencias autocomplete -->
                    <LinearLayout
                        android:id="@+id/layout_sugerencias_destino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:elevation="4dp"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"/>

                    <!-- Botón buscar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buscar_viajes"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:text="Buscar viajes disponibles"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.04"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#00CED1"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_menu_compass"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:iconTint="#FFFFFF"
                        app:elevation="4dp"
                        app:rippleColor="#40FFFFFF"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ESTADO: BUSCANDO -->
            <LinearLayout
                android:id="@+id/layout_buscando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E0FFFE"
                    app:strokeWidth="0dp">
                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#00CED1"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:text="Buscando conductores cerca de tu ruta..."
                    android:textSize="14sp"
                    android:textColor="#7A9BAA"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- LABEL RESULTADOS -->
            <LinearLayout
                android:id="@+id/layout_label_resultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_line_teal_rounded"/>

                <TextView
                    android:id="@+id/txt_label_resultados"
                    android:text="Conductores que pasan cerca de ti"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A2F4A"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_contador_resultados"
                    android:text="0"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_chip_teal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- RESULTADOS VIAJES -->
            <LinearLayout
                android:id="@+id/layout_resultados_viajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- ESTADO: SIN RESULTADOS -->
            <LinearLayout
                android:id="@+id/layout_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:src="@drawable/moviflesx"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:alpha="0.7"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Sin viajes"/>

                <TextView
                    android:id="@+id/txt_vacio"
                    android:text="No encontramos viajes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A2F4A"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txt_vacio_sub"
                    android:text="No hay conductores que pasen cerca de tu zona"
                    android:textSize="14sp"
                    android:textColor="#7A9BAA"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_buscar_desde_vacio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:backgroundTint="#00CED1"/>
            </LinearLayout>

            <!-- MIS RESERVAS ACTIVAS -->
            <LinearLayout
                android:id="@+id/layout_label_mis_reservas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_line_teal_rounded"/>

                <TextView
                    android:text="Tus reservas activas"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A2F4A"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_mis_reservas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>