<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp">

    <!-- ── TÍTULO del slide ── -->
    <TextView
        android:id="@+id/slideTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Viaja con tu\ncomunidad"
        android:textSize="30sp"
        android:textColor="#00CED1"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:lineSpacingExtra="3dp"/>

    <!-- ── SUBTÍTULO del slide ── -->
    <TextView
        android:id="@+id/slideSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Conecta con vecinos y viaja de forma\neconómica, segura y sostenible."
        android:textSize="14sp"
        android:textColor="#4A6070"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="5dp"/>

    <!-- ── 3 PILLS de estadísticas ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <!-- Pill 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_pill"
            android:layout_marginEnd="6dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/statVal1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10K+"
                android:textSize="17sp"
                android:textColor="#1A2035"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/statLbl1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuarios"
                android:textSize="10sp"
                android:textColor="#7B9EA3"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Pill 2 (resaltado teal) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_pill_teal"
            android:layout_marginHorizontal="6dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/statVal2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50+"
                android:textSize="17sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/statLbl2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rutas"
                android:textSize="10sp"
                android:textColor="#CCF5F3"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Pill 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_pill"
            android:layout_marginStart="6dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/statVal3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.9★"
                android:textSize="17sp"
                android:textColor="#1A2035"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/statLbl3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calificación"
                android:textSize="10sp"
                android:textColor="#7B9EA3"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>