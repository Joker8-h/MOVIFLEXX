<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#D0ECEC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ════════════════════════════════════════
             CABECERA — teal sólido consistente
        ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="141dp"
            android:background="@drawable/fondooomoviflex"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <!-- Blob decorativo pequeño -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-20dp"
                    android:layout_marginEnd="-20dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_glow_circle_teal"
                    android:clickable="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Fila ruta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Ícono ruta -->
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_icon_circle_white_alpha">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Ruta"
                                android:src="@drawable/ic_menu_compass"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtRuta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="Ruta no disponible"
                            android:textColor="#1A2F4A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Badge estado -->
                    <TextView
                        android:id="@+id/txtEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="48dp"

                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="Publicado"
                        android:textColor="#1A2F4A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CUERPO — blanco limpio
        ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <!-- Fecha + Precio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- Chip fecha -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_teal_subtle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/txtFecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#1A2F4A"
                        android:textSize="12sp"
                        android:text="--"/>
                </LinearLayout>

                <!-- Chip precio -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_teal_subtle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/txtPrecio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#00868A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="--"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Cupos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_teal_subtle"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥"
                        android:textSize="12sp"
                        android:backgroundTint="#7A9BAA"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/txtCupos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A2F4A"
                        android:textSize="12sp"
                        android:text="0 / 0 cupos"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEF5F5"
                android:layout_marginBottom="12dp"/>

            <!-- Conductor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/txtAvatarInicialCard"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="C"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_avatar_ring_white"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtConductor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A2F4A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="Conductor"/>

                    <TextView
                        android:id="@+id/txtTelefono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7A9BAA"
                        android:textSize="11sp"
                        android:text=""/>
                </LinearLayout>
            </LinearLayout>

            <!-- Vehículo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_icon_circle_teal_light">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_car"
                        app:tint="#7A9BAA"
                        android:contentDescription="Vehículo"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtVehiculo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A9BAA"
                    android:textSize="12sp"
                    android:text="Vehículo no asignado"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ════════════════════════════════════════
             SECCIÓN PASAJEROS — Solo visible al conductor
        ════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutSeccionPasajeros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#F0FAFA"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_line_teal_rounded"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/txtTituloPasajeros"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pasajeros a bordo"
                    android:textColor="#1A2F4A"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtContadorPasajeros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/bg_chip_teal"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loaderPasajeros"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="#00CED1"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/layoutPasajerosLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/txtSinPasajeros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin reservas activas aún"
                android:textColor="#7A9BAA"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ════════════════════════════════════════
             ZONA BOTONES — fondo muy suave
        ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:background="#F8FFFE"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Reservar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Reservar"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#00CED1"
                app:cornerRadius="18dp"
                app:rippleColor="#40FFFFFF"/>

            <!-- Iniciar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="▶  Iniciar"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#00CED1"
                app:cornerRadius="18dp"
                app:rippleColor="#40FFFFFF"/>

            <!-- Finalizar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalizar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="✔  Finalizar"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#00CED1"
                app:cornerRadius="18dp"
                app:rippleColor="#40FFFFFF"/>

            <!-- Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Cancelar"
                android:textSize="12sp"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:strokeColor="#EF4444"
                app:strokeWidth="1.5dp"
                app:cornerRadius="18dp"
                app:rippleColor="#20EF4444"/>

            <!-- Calificar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalificar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="⭐ Calificar"
                android:textSize="12sp"
                android:textColor="#1A2F4A"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#FFF3E0"
                app:strokeColor="#FF9800"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                app:rippleColor="#20FF9800"/>

            <!-- Resumen — conductor en FINALIZADO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumen"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Resumen"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:backgroundTint="#00CED1"
                app:cornerRadius="18dp"
                app:rippleColor="#40FFFFFF"/>

            <!-- Ver detalle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ver detalle"
                android:textSize="12sp"
                android:textColor="#7A9BAA"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:strokeColor="#D0ECEC"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                app:rippleColor="#10000000"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>