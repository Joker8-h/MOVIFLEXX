<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ════════════════════════════════════════════════════
         HEADER — teal sólido
    ════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_pago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#00CED1"
        android:orientation="vertical"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-30dp"
                android:alpha="0.15"
                android:background="@drawable/bg_glow_circle_teal"
                android:clickable="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:background="@drawable/fondooomoviflex"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="36dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp">

                <FrameLayout
                    android:id="@+id/btn_back_pago"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_icon_circle_white_alpha"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volver"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#7A9BAA" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.22"
                        android:text="MOVIFLEX"
                        android:textColor="#00CED1"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pago del viaje"
                        android:textColor="#1A2F4A"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/loader_pago"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════
         SCROLL
    ════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/header_pago"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp">

            <!-- Banner error -->
            <TextView
                android:id="@+id/txt_error_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_error_banner"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:visibility="gone"/>

            <!-- ════════════════════════════════════════════
                 CARD 1: MONTO
            ════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_datos_viaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D0ECEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Encabezado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <TextView
                            android:text="RESUMEN DEL PAGO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#00CED1"
                            android:letterSpacing="0.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Monto destacado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_teal_subtle"
                        android:paddingTop="28dp"
                        android:paddingBottom="28dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:text="TOTAL A PAGAR"
                            android:textSize="10sp"
                            android:textColor="#00CED1"
                            android:textStyle="bold"
                            android:letterSpacing="0.16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/txt_pago_monto"
                            android:text="$ —"
                            android:textColor="#1A2F4A"
                            android:textSize="38sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="COP"
                            android:textSize="12sp"
                            android:textColor="#7A9BAA"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_metodo_elegido"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#00868A"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════
                 CARD 2: MÉTODO DE PAGO
            ════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_metodo_pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D0ECEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Encabezado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:text="MÉTODO DE PAGO"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#00CED1"
                                android:letterSpacing="0.14"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:text="¿Cómo vas a pagar?"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A2F4A"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Opciones pago -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Efectivo -->
                        <LinearLayout
                            android:id="@+id/btn_opcion_efectivo"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="110dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_metodo_seleccionado">

                            <FrameLayout
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_marginBottom="8dp">
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_icono_metodo_verde"/>
                                <TextView
                                    android:text="💵"
                                    android:textSize="22sp"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </FrameLayout>

                            <TextView
                                android:text="Efectivo"
                                android:textColor="#1A2F4A"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Al conductor"
                                android:textColor="#7A9BAA"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Transferencia -->
                        <LinearLayout
                            android:id="@+id/btn_opcion_transferencia"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="110dp"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_metodo_normal">

                            <FrameLayout
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_marginBottom="8dp">
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_icono_metodo_azul"/>
                                <TextView
                                    android:text="📲"
                                    android:textSize="22sp"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </FrameLayout>

                            <TextView
                                android:text="Transferencia"
                                android:textColor="#1A2F4A"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Nequi · Daviplata"
                                android:textColor="#7A9BAA"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Botón confirmar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirmar_pago"
                        android:text="CONFIRMAR PAGO"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="18dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.06"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@null"
                        android:background="@drawable/bg_btn_login"
                        app:cornerRadius="14dp"
                        app:elevation="4dp"
                        app:rippleColor="#40FFFFFF"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════
                 CARD 3: ESTADO
            ════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estado_pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D0ECEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <TextView
                            android:text="ESTADO DEL PAGO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#00CED1"
                            android:letterSpacing="0.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_estado_pago"
                        android:text="⏳ Procesando…"
                        android:textColor="#1A2F4A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/txt_mensaje_espera"
                        android:text=""
                        android:textColor="#7A9BAA"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════
                 CARD 4: CONFIRMACIONES
            ════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_confirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D0ECEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <TextView
                            android:text="CONFIRMACIONES"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#00CED1"
                            android:letterSpacing="0.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Pasajero -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <View
                            android:id="@+id/check_icon_pasajero"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_check_pending"
                            android:layout_marginEnd="14dp"/>

                        <TextView
                            android:id="@+id/txt_check_pasajero"
                            android:text="Tú — pendiente de confirmar"
                            android:textColor="#7A9BAA"
                            android:textSize="13sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEF5F5"
                        android:layout_marginBottom="14dp"/>

                    <!-- Conductor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <View
                            android:id="@+id/check_icon_conductor"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_check_pending"
                            android:layout_marginEnd="14dp"/>

                        <TextView
                            android:id="@+id/txt_check_conductor"
                            android:text="Conductor — esperando confirmación"
                            android:textColor="#7A9BAA"
                            android:textSize="13sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Botón confirmé que pagué -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirme_pague"
                        android:text="✅  CONFIRMÉ QUE PAGUÉ"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:visibility="gone"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.04"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="#00CED1"
                        app:cornerRadius="14dp"
                        app:elevation="4dp"
                        app:rippleColor="#40FFFFFF"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>