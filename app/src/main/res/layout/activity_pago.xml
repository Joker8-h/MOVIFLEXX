<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ══════════════════════════════════════════════════
         HEADER TURQUESA
         ══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_pago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botón volver -->
            <TextView
                android:id="@+id/btn_back_pago"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:text="MOVIFLEX"
                    android:textColor="#A8EEE6"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Pago del viaje"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Loader global -->
            <ProgressBar
                android:id="@+id/loader_pago"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="gone"
                android:indeterminateTint="#FFFFFF"/>

        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════
         SCROLL PRINCIPAL
         ══════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="36dp"
        app:layout_constraintTop_toBottomOf="@id/header_pago"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp">

            <!-- ─────────────────────────────────────────
                 CARD 1: RESUMEN DEL PAGO (solo monto + método)
                 ───────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_datos_viaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Encabezado sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:text="RESUMEN DEL PAGO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#00897B"
                            android:letterSpacing="0.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Total a pagar — grande y centrado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_teal_subtle"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:text="TOTAL A PAGAR"
                            android:textSize="10sp"
                            android:textColor="#00897B"
                            android:textStyle="bold"
                            android:letterSpacing="0.16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/txt_pago_monto"
                            android:text="$ —"
                            android:textColor="#004D40"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="COP"
                            android:textSize="12sp"
                            android:textColor="#80CBC4"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                    <!-- Método elegido (visible solo después de seleccionar) -->
                    <TextView
                        android:id="@+id/txt_metodo_elegido"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#00695C"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────────
                 CARD 2: MÉTODO DE PAGO
                 ───────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_metodo_pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Encabezado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView android:text="MÉTODO DE PAGO"
                                android:textSize="10sp" android:textStyle="bold"
                                android:textColor="#00897B" android:letterSpacing="0.14"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                            <TextView android:text="¿Cómo vas a pagar?"
                                android:textSize="14sp" android:textStyle="bold"
                                android:textColor="#004D40" android:layout_marginTop="2dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Opciones -->
                    <RadioGroup
                        android:id="@+id/rg_metodo_pago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Efectivo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_option_selector"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:layout_marginBottom="10dp">

                            <RadioButton
                                android:id="@+id/rb_efectivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#00897B"
                                android:layout_marginEnd="10dp"/>

                            <TextView android:text="💵" android:textSize="22sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:text="Efectivo"
                                    android:textColor="#004D40" android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:text="Pago en mano al conductor"
                                    android:textColor="#80CBC4" android:textSize="11sp"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Transferencia -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_option_selector"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <RadioButton
                                android:id="@+id/rb_transferencia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#00897B"
                                android:layout_marginEnd="10dp"/>

                            <TextView android:text="📲" android:textSize="22sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:text="Transferencia"
                                    android:textColor="#004D40" android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:text="Nequi, Daviplata o transferencia bancaria"
                                    android:textColor="#80CBC4" android:textSize="11sp"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>

                    </RadioGroup>

                    <!-- Botón confirmar pago -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirmar_pago"
                        android:text="CONFIRMAR PAGO"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="18dp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:letterSpacing="0.04"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#00897B"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────────
                 CARD 3: ESTADO DEL PAGO
                 ───────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estado_pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <TextView android:text="ESTADO DEL PAGO"
                            android:textSize="10sp" android:textStyle="bold"
                            android:textColor="#00897B" android:letterSpacing="0.14"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_estado_pago"
                        android:text="⏳ Procesando…"
                        android:textColor="#004D40"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/txt_mensaje_espera"
                        android:text=""
                        android:textColor="#546E7A"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────────
                 CARD 4: CONFIRMACIONES (checks)
                 ───────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_confirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#E0F2F1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_accent_bar"
                            android:layout_marginEnd="10dp"/>

                        <TextView android:text="CONFIRMACIONES"
                            android:textSize="10sp" android:textStyle="bold"
                            android:textColor="#00897B" android:letterSpacing="0.14"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Check Pasajero -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <View
                            android:id="@+id/check_icon_pasajero"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_check_pending"
                            android:layout_marginEnd="14dp"/>

                        <TextView
                            android:id="@+id/txt_check_pasajero"
                            android:text="Tú — pendiente de confirmar"
                            android:textColor="#757575"
                            android:textSize="13sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0F2F1"
                        android:layout_marginBottom="14dp"/>

                    <!-- Check Conductor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <View
                            android:id="@+id/check_icon_conductor"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_check_pending"
                            android:layout_marginEnd="14dp"/>

                        <TextView
                            android:id="@+id/txt_check_conductor"
                            android:text="Conductor — esperando confirmación"
                            android:textColor="#757575"
                            android:textSize="13sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Botón "Confirmé que pagué" -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirme_pague"
                        android:text="CONFIRMÉ QUE PAGUÉ"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:visibility="gone"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.04"
                        app:cornerRadius="14dp"
                        app:backgroundTint="#0097A7"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>