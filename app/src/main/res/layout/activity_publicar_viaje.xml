<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- ══════════════════════════════════════════
         HEADER TEAL
         ══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/fondooomoviflex"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="52dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.14"
                android:text="MOVIFLEX · CONDUCTOR"
                android:textColor="#1A2F4A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txt_header_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:letterSpacing="-0.01"
                android:text="Publicar viaje"
                android:textColor="#1A2F4A"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chip_estado_header"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <View
                        android:id="@+id/dot_estado_header"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_circle_white" />

                    <TextView
                        android:id="@+id/txt_estado_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disponible"
                        android:textColor="#1A2F4A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Popayán"
                        android:textColor="#1A2F4A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"

                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compartido"
                        android:textColor="#1A2F4A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════
         SCROLL CONTENT
         ══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_principal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- ══════════════════════════════════════════
                 ★ CARD VIAJE ACTIVO (visible cuando ya hay un viaje)
                 ══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_viaje_activo"
                style="@style/Card.Moviflexx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:strokeColor="#00BCD4"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Encabezado: icono + título + badge estado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/teal_100"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_car"
                                android:contentDescription="Viaje activo"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VIAJE ACTIVO"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@color/teal_600"
                                android:letterSpacing="0.14"
                                android:layout_marginBottom="2dp"/>
                            <TextView
                                android:id="@+id/txt_viaje_activo_ruta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Origen → Destino"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>

                        <!-- Badge estado -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F5E9"
                            app:strokeWidth="0dp">
                            <TextView
                                android:id="@+id/txt_viaje_activo_estado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● ACTIVO"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Divisor -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_100" android:layout_marginBottom="16dp"/>

                    <!-- Stats del viaje: cupos / precio / hora -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="16dp">

                        <!-- Cupos -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:gravity="center" android:paddingEnd="6dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/teal_50"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="👥" android:textSize="18sp"
                                        android:layout_marginBottom="4dp"/>
                                    <TextView
                                        android:id="@+id/txt_viaje_activo_cupos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="—"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/teal_700"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="cupos"
                                        android:textSize="10sp"
                                        android:textColor="@color/gray_400"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Precio -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/teal_50"
                                app:strokeWidth="0dp">
                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="12dp">
                                    <TextView android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="18sp"
                                        android:layout_marginBottom="4dp"/>
                                    <TextView
                                        android:id="@+id/txt_viaje_activo_precio"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="—"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/teal_700"
                                        android:ellipsize="end"
                                        android:maxLines="1"/>
                                    <TextView android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="por pasajero"
                                        android:textSize="10sp"
                                        android:textColor="@color/gray_400"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Hora -->
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:gravity="center" android:paddingStart="6dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/teal_50"
                                app:strokeWidth="0dp">
                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="18sp"
                                        android:layout_marginBottom="4dp"/>

                                    <TextView
                                        android:id="@+id/txt_viaje_activo_hora"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="—"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/teal_700"
                                        android:ellipsize="end"
                                        android:maxLines="1"/>
                                    <TextView android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="salida"
                                        android:textSize="10sp"
                                        android:textColor="@color/gray_400"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Aviso: no puedes crear otro -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF8E1"
                        app:strokeColor="#FFE082"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️"
                                android:textSize="20sp"
                                android:layout_marginEnd="10dp"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Ya tienes un viaje activo. Finalízalo para poder crear uno nuevo."
                                android:textSize="13sp"
                                android:textColor="#5D4037"
                                android:lineSpacingMultiplier="1.3"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Botones: Ver mapa + Finalizar viaje -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_ver_mapa_viaje_activo"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:text="Ver mapa"
                            android:textColor="@color/teal_600"
                            app:strokeColor="@color/teal_500"
                            app:strokeWidth="1.5dp"
                            app:cornerRadius="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_finalizar_viaje_activo"
                            style="@style/Button.Moviflexx.Primary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="Finalizar viaje"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════
                 MAIN CARD FORMULARIO (visible cuando NO hay viaje activo)
                 ══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/main_card"
                style="@style/Card.Moviflexx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- ── VEHÍCULO ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEHÍCULO REGISTRADO"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_600"
                        android:letterSpacing="0.14"
                        android:layout_marginBottom="10dp"/>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Moviflexx.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/teal_100"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_car"
                                    android:contentDescription="Vehículo"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                android:id="@+id/txt_vehiculo_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cargando vehículo..."
                                android:textColor="@color/teal_800"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Moviflexx.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="12dp"
                                app:cardCornerRadius="17dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/teal_500"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@android:drawable/ic_menu_directions"
                                    android:contentDescription="Conductor"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                android:id="@+id/txt_conductor_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Conductor: Cargando..."
                                android:textColor="@color/teal_800"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_100" android:layout_marginBottom="20dp"/>

                    <!-- ── RUTA ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RUTA DEL VIAJE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_600"
                        android:letterSpacing="0.14"
                        android:layout_marginBottom="10dp"/>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Moviflexx.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="22dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:layout_marginEnd="12dp">

                                <View
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:background="@drawable/bg_circle_teal"
                                    android:layout_gravity="center_horizontal"/>

                                <View android:layout_width="2dp" android:layout_height="22dp"
                                    android:background="@color/teal_200"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>
                                <View android:layout_width="10dp" android:layout_height="10dp"
                                    android:background="@drawable/circle_red_dot"
                                    android:layout_gravity="center_horizontal"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_origen_info"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando origen..."
                                    android:textColor="@color/teal_600"
                                    android:textSize="13sp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:layout_marginBottom="10dp"/>
                                <TextView
                                    android:id="@+id/txt_destino_info"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando destino..."
                                    android:textColor="@color/gray_900"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_100" android:layout_marginBottom="20dp"/>

                    <!-- ── FECHA Y HORA ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FECHA Y HORA DE SALIDA"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_600"
                        android:letterSpacing="0.14"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Input.Moviflexx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Toca para seleccionar fecha y hora"
                        app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:startIconTint="@color/teal_500">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_fecha_hora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:textColor="@color/gray_900"
                            android:textSize="14sp"
                            android:cursorVisible="false"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca el campo para elegir fecha y hora de salida"
                        android:textSize="11sp"
                        android:textColor="@color/gray_400"
                        android:layout_marginBottom="20dp"
                        android:layout_marginStart="4dp"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_100" android:layout_marginBottom="20dp"/>

                    <!-- ── CUPOS + PRECIO ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="CUPOS" android:textSize="9sp" android:textStyle="bold"
                                android:textColor="@color/teal_600" android:letterSpacing="0.14"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Según tu vehículo" android:textSize="10sp"
                                android:textColor="@color/gray_400" android:layout_marginBottom="8dp"/>
                            <com.google.android.material.card.MaterialCardView
                                style="@style/Card.Moviflexx.Flat"
                                android:layout_width="match_parent" android:layout_height="wrap_content">
                                <Spinner android:id="@+id/spinnerCupo"
                                    android:layout_width="match_parent" android:layout_height="54dp"
                                    android:paddingStart="12dp" android:paddingEnd="12dp"
                                    android:background="@android:color/transparent"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="PRECIO / PASAJERO" android:textSize="9sp" android:textStyle="bold"
                                android:textColor="@color/teal_600" android:letterSpacing="0.14"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Calculado automáticamente" android:textSize="10sp"
                                android:textColor="@color/gray_400" android:layout_marginBottom="8dp"/>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Input.Moviflexx"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:hint="Monto" app:prefixText="$ ">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_precio"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:textColor="@color/gray_900" android:textSize="14sp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Precio sugerido -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/txt_precio_sugerido_card"
                        style="@style/Card.Moviflexx.Flat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/txt_precio_sugerido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Precio Total"
                            android:textSize="12sp"
                            android:textColor="@color/teal_700"
                            android:padding="14dp"
                            android:lineSpacingExtra="3dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Botón publicar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_publicar_viaje"
                        style="@style/Button.Moviflexx.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:text="PUBLICAR VIAJE EN POPAYÁN"
                        android:letterSpacing="0.04"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card info -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metadata_card"
                style="@style/Card.Moviflexx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="18dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent"
                        android:background="@color/teal_300" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ℹ️ Información del servicio"
                            android:textSize="13sp" android:textColor="@color/teal_600"
                            android:textStyle="bold" android:layout_marginBottom="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="El viaje estará visible para todos los usuarios en la ciudad de Popayán. Los pasajeros podrán reservar en tiempo real."
                            android:textSize="13sp" android:textColor="@color/gray_600"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card estadísticas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stats_card"
                style="@style/Card.Moviflexx.Teal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="18dp" android:weightSum="3">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ESTADO" android:textSize="9sp" android:textColor="#B2EDE8"
                            android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Programado" android:textSize="14sp" android:textColor="#FFFFFF"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#4DFFFFFF"/>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CIUDAD" android:textSize="9sp" android:textColor="#B2EDE8"
                            android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Popayán" android:textSize="14sp" android:textColor="#FFFFFF"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#4DFFFFFF"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TIPO" android:textSize="9sp" android:textColor="#B2EDE8"
                            android:letterSpacing="0.14" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Compartido" android:textSize="14sp" android:textColor="#FFFFFF"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- OVERLAY LOADER -->
    <View
        android:id="@+id/overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loader_container"
        style="@style/Card.Moviflexx"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardElevation="16dp"
        app:cardCornerRadius="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="28dp">
            <ProgressBar android:id="@+id/loader_viaje"
                android:layout_width="52dp" android:layout_height="52dp"
                android:indeterminateTint="@color/teal_500"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Publicando viaje" android:textColor="@color/teal_700"
                android:textStyle="bold" android:layout_marginTop="18dp"
                android:textSize="14sp" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Por favor espere..." android:textColor="@color/gray_400"
                android:layout_marginTop="6dp" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/BottomNav.Moviflexx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_navigation_menu"
        app:elevation="12dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>