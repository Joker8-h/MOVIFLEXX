<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- ══════════════════════════════════════════
         HEADER CARD
         ══════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/header_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#00897B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#00897B">

            <TextView
                android:id="@+id/titulo_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUBLICAR VIAJE"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"/>

            <View
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:background="#4DD0E1"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure los detalles del servicio de transporte"
                android:textColor="#B2DFDB"
                android:textSize="14sp"
                android:letterSpacing="0.01"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ══════════════════════════════════════════
         SCROLL VIEW PRINCIPAL
         ══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_principal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════════════════════════════════
                 CARD PRINCIPAL  (animada desde Java: alpha 0→1)
                 ══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/main_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- ─── VEHÍCULO REGISTRADO ─── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehículo Registrado"
                        android:textSize="12sp"
                        android:textColor="#00796B"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#E0F2F1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_directions"
                                android:tint="#00897B"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="Icono vehículo"/>

                            <TextView
                                android:id="@+id/txt_vehiculo_info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cargando vehículo..."
                                android:textColor="#004D40"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium"
                                android:ellipsize="end"
                                android:maxLines="1"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ─── RUTA DEL VIAJE ─── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ruta del Viaje"
                        android:textSize="12sp"
                        android:textColor="#00796B"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#E0F2F1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <!-- Indicador visual origen → destino -->
                            <LinearLayout
                                android:layout_width="24dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:layout_marginEnd="12dp">

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:background="@drawable/circle_teal"
                                    android:layout_gravity="center_horizontal"/>

                                <View
                                    android:layout_width="2dp"
                                    android:layout_height="24dp"
                                    android:background="#80B2DFDB"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"/>

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@android:drawable/ic_dialog_map"
                                    android:tint="#00897B"
                                    android:layout_gravity="center_horizontal"
                                    android:contentDescription="Destino"/>
                            </LinearLayout>

                            <!-- Textos origen y destino -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txt_origen_info"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando origen..."
                                    android:textColor="#00695C"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:layout_marginBottom="10dp"/>

                                <TextView
                                    android:id="@+id/txt_destino_info"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando destino..."
                                    android:textColor="#004D40"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium"
                                    android:ellipsize="end"
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- DIVISOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#B2DFDB"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="24dp"/>

                    <!-- ─── FECHA Y HORA DE SALIDA ─── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha y Hora de Salida"
                        android:textSize="12sp"
                        android:textColor="#00796B"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:hint="Seleccione fecha y hora"
                        app:boxStrokeColor="#00BCD4"
                        app:hintTextColor="#00ACC1"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#E0F2F1"
                        app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:startIconTint="#00ACC1"
                        app:endIconMode="clear_text"
                        app:endIconTint="#00ACC1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_fecha_hora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:textColor="#004D40"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DIVISOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#B2DFDB"
                        android:layout_marginBottom="24dp"/>

                    <!-- ─── CUPOS Y PRECIO (fila horizontal) ─── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:baselineAligned="false">

                        <!-- CUPOS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cupos Disponibles"
                                android:textSize="12sp"
                                android:textColor="#00796B"
                                android:letterSpacing="0.1"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="12dp"/>

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#E0F2F1">

                                <Spinner
                                    android:id="@+id/spinnerCupo"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:entries="@array/cupos"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:background="@android:color/transparent"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <!-- PRECIO -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Precio por Pasajero"
                                android:textSize="12sp"
                                android:textColor="#00796B"
                                android:letterSpacing="0.1"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="12dp"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Monto"
                                app:prefixText="$ "
                                app:boxStrokeColor="#00BCD4"
                                app:hintTextColor="#00ACC1"
                                app:boxStrokeWidth="2dp"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxBackgroundColor="#E0F2F1"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_precio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:textColor="#004D40"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ─── BOTÓN PUBLICAR ─── -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_publicar_viaje"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="32dp"
                        android:text="PUBLICAR VIAJE EN POPAYÁN"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_btn_login"
                        android:stateListAnimator="@null"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@null"
                        app:elevation="6dp"
                        app:rippleColor="#FFFFFF"
                        app:strokeWidth="0dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════
                 CARD DE INFORMACIÓN
                 (alpha="1" — Java no la anima, debe ser visible)
                 ══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/metadata_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="#26C6DA"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ℹ️ Información del Servicio"
                            android:textSize="13sp"
                            android:textColor="#00897B"
                            android:letterSpacing="0.05"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="El viaje estará visible para todos los usuarios en la ciudad de Popayán. Los pasajeros podrán reservar en tiempo real."
                            android:textSize="13sp"
                            android:textColor="#00695C"
                            android:lineSpacingExtra="4dp"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════
                 CARD DE ESTADÍSTICAS
                 (alpha="1" — Java no la anima, debe ser visible)
                 ══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#00897B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:weightSum="3"
                    android:background="#00897B">

                    <!-- ESTADO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTADO"
                            android:textSize="10sp"
                            android:textColor="#B2DFDB"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Activo"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#4DD0E1"
                        android:alpha="0.5"/>

                    <!-- CIUDAD -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CIUDAD"
                            android:textSize="10sp"
                            android:textColor="#B2DFDB"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Popayán"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#4DD0E1"
                        android:alpha="0.5"/>

                    <!-- TIPO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TIPO"
                            android:textSize="10sp"
                            android:textColor="#B2DFDB"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compartido"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════
         OVERLAY LOADER (visible="gone por defecto)
         ══════════════════════════════════════════ -->
    <View
        android:id="@+id/overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/loader_container"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <ProgressBar
                android:id="@+id/loader_viaje"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="#00BCD4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publicando viaje"
                android:textColor="#00695C"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Por favor espere..."
                android:textColor="#4DB6AC"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ══════════════════════════════════════════
         BOTTOM NAVIGATION
         ══════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/bottom_navigation_menu"
        app:labelVisibilityMode="labeled"
        app:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>