<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- HEADER PROFESIONAL CON ELEVATION -->
    <androidx.cardview.widget.CardView
        android:id="@+id/header_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#6C3BFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/header_gradient">

            <TextView
                android:id="@+id/titulo_header"
                android:text="PUBLICAR VIAJE"
                android:textColor="#FAFAFC"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="#FAFAFC"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.8"/>

            <TextView
                android:text="Configure los detalles del servicio de transporte"
                android:textColor="#EDE7FF"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.95"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- SCROLL VIEW PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CARD PRINCIPAL CON GLASSMORPHISM -->
            <androidx.cardview.widget.CardView
                android:id="@+id/main_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#FAFAFC"
                android:translationY="20dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:background="@drawable/card_glassmorphism">

                    <!-- SECCIÓN VEHÍCULO -->
                    <TextView
                        android:text="VEHÍCULO ASIGNADO"
                        android:textSize="11sp"
                        android:textColor="#8A8A8A"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Spinner
                        android:id="@+id/spinnerVehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@drawable/input_professional"
                        android:padding="16dp"
                        android:layout_marginBottom="28dp"/>

                    <!-- DIVISOR SUTIL -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDE7FF"
                        android:layout_marginBottom="28dp"/>

                    <!-- SECCIÓN FECHA Y HORA -->
                    <TextView
                        android:text="FECHA Y HORA DE SALIDA"
                        android:textSize="11sp"
                        android:textColor="#8A8A8A"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Seleccione fecha y hora"
                        app:boxStrokeColor="#6C3BFF"
                        app:hintTextColor="#6C3BFF"
                        app:boxStrokeWidth="2dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxBackgroundColor="#F4F4F6"
                        app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:startIconTint="#6C3BFF"
                        android:layout_marginBottom="28dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_fecha_hora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:textColor="#2B2B2B"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DIVISOR SUTIL -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDE7FF"
                        android:layout_marginBottom="28dp"/>

                    <!-- SECCIÓN CUPOS Y PRECIO EN GRID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:baselineAligned="false">

                        <!-- CUPOS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:text="CUPOS DISPONIBLES"
                                android:textSize="11sp"
                                android:textColor="#8A8A8A"
                                android:letterSpacing="0.15"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <Spinner
                                android:id="@+id/spinnerCupo"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:entries="@array/cupos"
                                android:padding="12dp"/>
                        </LinearLayout>

                        <!-- PRECIO -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:text="PRECIO POR PASAJERO"
                                android:textSize="11sp"
                                android:textColor="#8A8A8A"
                                android:letterSpacing="0.15"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Monto"
                                app:prefixText="$ "
                                app:boxStrokeColor="#6C3BFF"
                                app:hintTextColor="#6C3BFF"
                                app:boxStrokeWidth="2dp"
                                app:boxCornerRadiusTopStart="8dp"
                                app:boxCornerRadiusTopEnd="8dp"
                                app:boxCornerRadiusBottomStart="8dp"
                                app:boxCornerRadiusBottomEnd="8dp"
                                app:boxBackgroundColor="#F4F4F6"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_precio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:textColor="#2B2B2B"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BOTÓN PRINCIPAL ENTERPRISE -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_publicar_viaje"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="36dp"
                        android:text="PUBLICAR EN POPAYÁN"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-medium"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#6C3BFF"
                        android:textColor="#FAFAFC"
                        app:elevation="8dp"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- METADATA CARD PROFESIONAL -->
            <androidx.cardview.widget.CardView
                android:id="@+id/metadata_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FAFAFC"
                android:translationY="20dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:background="@drawable/gradient_header">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#6C3BFF"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:text="INFORMACIÓN DEL SERVICIO"
                            android:textSize="11sp"
                            android:textColor="#6C3BFF"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="El viaje estará visible para todos los usuarios en la ciudad de Popayán. Los pasajeros podrán reservar en tiempo real."
                            android:textSize="12sp"
                            android:textColor="#2B2B2B"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-light"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ESTADÍSTICAS RÁPIDAS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#6C3BFF"
                android:translationY="20dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:text="ESTADO"
                            android:textSize="9sp"
                            android:textColor="#EDE7FF"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Activo"
                            android:textSize="13sp"
                            android:textColor="#FAFAFC"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EDE7FF"
                        android:alpha="0.3"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:text="CIUDAD"
                            android:textSize="9sp"
                            android:textColor="#EDE7FF"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Popayán"
                            android:textSize="13sp"
                            android:textColor="#FAFAFC"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#EDE7FF"
                        android:alpha="0.3"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:text="TIPO"
                            android:textSize="9sp"
                            android:textColor="#EDE7FF"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Compartido"
                            android:textSize="13sp"
                            android:textColor="#FAFAFC"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- OVERLAY LOADER PROFESIONAL -->
    <View
        android:id="@+id/overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/loader_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="#FAFAFC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/loader_viaje"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:indeterminateTint="#6C3BFF"/>

            <TextView
                android:text="Publicando servicio..."
                android:textColor="#2B2B2B"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Por favor espere"
                android:textColor="#8A8A8A"
                android:layout_marginTop="4dp"
                android:textSize="10sp"
                android:fontFamily="sans-serif-light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BOTTOM NAVIGATION PROFESIONAL -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAFAFC"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/bottom_navigation_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:elevation="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>