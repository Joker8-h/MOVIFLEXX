<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <!-- Avatar circular con badge -->
        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#00CED1"
                app:strokeWidth="0dp">
                <TextView
                    android:id="@+id/tv_inicial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#00CED1"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp">
                <ImageView
                    android:id="@+id/iv_badge_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_chat"
                    android:padding="4dp"
                    app:tint="#FFFFFF"/>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Texto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_notif_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carlos te envió un mensaje"
                android:textColor="#1A2F4A"
                android:textSize="14.5sp"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_notif_fecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="hace 5 min"
                android:textColor="#00CED1"
                android:textSize="12.5sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Punto turquesa no leído -->
        <View
            android:id="@+id/view_dot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dot_online"
            android:visibility="gone"/>

        <!-- Botón 3 puntos -->
        <ImageView
            android:id="@+id/btn_more_notif"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_more_vert"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="#7A9BAA"
            android:contentDescription="Más opciones"/>

    </LinearLayout>

    <!-- Divisor sutil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="84dp"
        android:layout_marginEnd="16dp"
        android:background="#EEF5F5"/>

</LinearLayout>