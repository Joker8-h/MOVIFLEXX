<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ══ BARRA SUPERIOR ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2EC4B6"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📄 Términos y Condiciones — MOVIFLEX"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCerrarTerminosTop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:background="@android:color/transparent"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ══ AVISO: leer hasta el final ══ -->
    <TextView
        android:id="@+id/tvAvisoLeer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8E1"
        android:text="⚠️  Desplázate hasta el final para poder aceptar los términos."
        android:textColor="#7B5800"
        android:textSize="12sp"
        android:padding="12dp" />

    <!-- ══ CONTENIDO DEL CONTRATO ══ -->
    <ScrollView
        android:id="@+id/scrollTerminos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ENCABEZADO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTRATO MARCO DE LICENCIA DE USO DE SOFTWARE,\nINTERMEDIACIÓN TECNOLÓGICA Y ESTATUTO DE TÉRMINOS\nY CONDICIONES GLOBALES DE LA PLATAFORMA «MOVIFLEX»"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VERSIÓN: 1.0 (2024)  |  DOMICILIO LEGAL: POPAYÁN, CAUCA, COLOMBIA."
                android:textColor="#444444"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingBottom="2dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMPRESA: MOVIFLEX S.A.S. (NIT EN TRÁMITE)"
                android:textColor="#444444"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:background="#2EC4B6" android:layout_marginBottom="16dp"/>

            <!-- ── PREÁMBULO ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PREÁMBULO: DECLARACIÓN DE VOLUNTAD Y NATURALEZA JURÍDICA"
                android:textColor="#2EC4B6" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="El presente documento constituye un acuerdo legal vinculante y obligatorio (en adelante, el «CONTRATO») entre MOVIFLEX S.A.S., sociedad comercial colombiana con domicilio en Popayán (en adelante, «LA COMPAÑÍA» o «MOVIFLEX»), y cualquier persona natural o jurídica que decida registrarse, descargar o utilizar el ecosistema digital (en adelante, el «USUARIO» o el «CONDUCTOR», y colectivamente las «PARTES»)."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO I ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO I: NATURALEZA DEL OBJETO SOCIAL Y LA ACTIVIDAD TECNOLÓGICA"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 1 — Definición de la actividad"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MOVIFLEX S.A.S. no presta servicio de transporte público ni privado. Es una Empresa de Base Tecnológica (EBT) dedicada exclusivamente al desarrollo y licenciamiento de software. Actúa como CORREDOR TECNOLÓGICO (Art. 1340 del Código de Comercio Colombiano), facilitando el contacto entre quien demanda un servicio de movilidad y quien ofrece su capacidad de transporte autónomo."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 2 — Ausencia de habilitación de transporte"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MOVIFLEX no posee flota de vehículos, no ejerce control de la operación, no despacha vehículos y no recibe remuneración por flete, sino por «Tarifa de Licencia de Uso de Software». Por tanto, no requiere habilitación del Ministerio de Transporte como empresa transportadora."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO II ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO II: RÉGIMEN DE CONTRATACIÓN DEL CONDUCTOR (BLINDAJE LABORAL)"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 3 — Declaración expresa de independencia (Art. 23 C.S.T.)"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="El Conductor declara bajo juramento que su relación con MOVIFLEX es de naturaleza civil y comercial. Se deja constancia de la inexistencia de los elementos del contrato de trabajo:\n\n• NO SUBORDINACIÓN: El Conductor no está sujeto a reglamentos ni órdenes. Conserva la potestad de aceptar o rechazar cualquier viaje.\n\n• NO PRESTACIÓN EXCLUSIVA: Puede utilizar otras plataformas o dedicarse a otras actividades sin restricción.\n\n• NO REMUNERACIÓN SALARIAL: Los ingresos son pagos directos del Pasajero. MOVIFLEX no paga nómina, prestaciones, primas ni vacaciones."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 4 — Asunción de cargas prestacionales y parafiscales"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Conforme a la Ley 1562 de 2012 y el Decreto 1072 de 2015, el Conductor, como trabajador independiente, es el único responsable de su afiliación y pago al Sistema de Seguridad Social Integral (Salud, Pensión y ARL), y mantendrá indemne a MOVIFLEX ante cualquier reclamación de la UGPP."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO III ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO III: MODELOS ECONÓMICOS Y PACTOS DE ESTABILIDAD"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 5 — Esquemas de contraprestación"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="El Conductor puede elegir entre dos modalidades:\n\n• PLAN ESTÁNDAR: Comisión del 7 % por cada intermediación exitosa.\n\n• PLAN PRO CONDUCTOR FUNDADOR: Suscripción mensual de $30.000 COP, con Pacto de Estabilidad de Precio de por vida para quienes se vinculen durante el lanzamiento en Popayán, siempre que no interrumpan la suscripción por más de 30 días."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO IV ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO IV: EXONERACIÓN DE RESPONSABILIDAD (BLINDAJE CIVIL Y PENAL)"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 6 — Cláusula de indemnidad por riesgo operativo"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Dado que el transporte es una actividad peligrosa (Art. 2356 del Código Civil), las PARTES asumen el riesgo total de la operación. MOVIFLEX no responderá por:\n\n• Accidentes de tránsito: se rigen por el SOAT y la responsabilidad civil del propietario del vehículo.\n\n• Responsabilidad penal: delitos cometidos dentro del vehículo son responsabilidad estrictamente individual de su autor.\n\n• Objetos prohibidos: se prohíbe el transporte de armas, drogas o sustancias explosivas."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO V ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO V: SEGURIDAD, PRUEBAS JUDICIALES Y TECNOLOGÍA"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 7 — Consentimiento para el uso de medios audiovisuales"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="En virtud de la Ley 906 de 2004, las PARTES otorgan consentimiento expreso para que la plataforma grabe audio y video durante los trayectos. Estas grabaciones solo se revelarán ante orden judicial o para dirimir conflictos internos, y constituyen prueba plena en procesos civiles o denuncias ante la Fiscalía General de la Nación."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO VI ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO VI: POLÍTICA DE DATOS PERSONALES (HABEAS DATA)"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 8 — Cumplimiento Ley 1581 de 2012"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MOVIFLEX S.A.S., como Responsable del Tratamiento, recolectará datos sensibles (biometría, ubicación GPS, voz). El titular autoriza su tratamiento para:\n\n1. Geolocalización en tiempo real del servicio.\n2. Verificación de identidad mediante reconocimiento facial.\n3. Fines comerciales y de marketing de MOVIFLEX."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO VII ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO VII: RÉGIMEN DISCIPLINARIO Y PENALIDADES"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 9 — Multas por cancelación (cláusula penal)"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Para proteger la confianza del consumidor se establecen multas por cancelación injustificada:\n\n• A partir de la 3.ª cancelación: $2.000 COP.\n• A partir de la 5.ª cancelación: $5.000 COP.\n\nEstas multas son una estimación anticipada de perjuicios por lucro cesante y daño a la imagen de la plataforma."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="16dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#DDDDDD" android:layout_marginBottom="16dp"/>

            <!-- ── CAPÍTULO VIII ── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAPÍTULO VIII: RESOLUCIÓN DE CONFLICTOS Y CLÁUSULA COMPROMISORIA"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ARTÍCULO 10 — Procedimiento de ley"
                android:textColor="#2EC4B6" android:textSize="12sp" android:textStyle="bold"
                android:paddingBottom="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Toda controversia se resolverá bajo los principios de economía y celeridad:\n\n1. Arreglo Directo: 15 días hábiles por escrito a somosmoviflex@gmail.com.\n2. Conciliación Obligatoria: en un Centro de Conciliación en Popayán (Ley 640 de 2001).\n3. Jurisdicción Ordinaria: jueces civiles del circuito de Popayán."
                android:textColor="#333333" android:textSize="13sp" android:paddingBottom="24dp"/>

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:background="#2EC4B6" android:layout_marginBottom="16dp"/>

            <!-- DECLARACIÓN FINAL -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="DECLARACIÓN DE ACEPTACIÓN"
                android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                android:paddingBottom="8dp"/>
            <TextView
                android:id="@+id/tvDeclaracionFinal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El Usuario y/o Conductor manifiesta que ha leído este documento, que entiende las implicaciones de la ausencia de relación laboral y la exoneración de responsabilidad de MOVIFLEX, y que acepta cada cláusula como ley para las partes."
                android:textColor="#333333" android:textSize="13sp"
                android:paddingBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ══ PIE: indicador + botones ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖  Desplázate hasta el final para habilitar el botón"
            android:textColor="#E65100"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnCerrarTerminos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar"
                android:textColor="#666666"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#E0E0E0" />

            <Button
                android:id="@+id/btnAceptarTerminos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓  Acepto los Términos"
                android:textColor="#FFFFFF"
                android:backgroundTint="#AAAAAA"
                android:textStyle="bold"
                android:enabled="false" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>