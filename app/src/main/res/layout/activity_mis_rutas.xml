<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFA">

    <!-- ════════════════════════════════════════════════════
         HEADER — teal sólido consistente
    ════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerMisRutas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#00CED1"
        android:elevation="4dp">

        <!-- Blob decorativo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-30dp"
                android:alpha="0.15"
                android:background="@drawable/bg_glow_circle_teal"
                android:clickable="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="36dp"
                android:paddingEnd="22dp"
                android:paddingBottom="0dp">

                <!-- Fila: Atrás + Título + Ícono -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <!-- Botón atrás -->
                    <FrameLayout
                        android:id="@+id/btnBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_icon_circle_white_alpha"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Volver"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="#FFFFFF"/>
                    </FrameLayout>

                    <!-- Títulos -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOVIFLEX"
                            android:textColor="#CCFFFE"
                            android:textSize="10sp"
                            android:letterSpacing="0.18"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis Rutas"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtContadorRutas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textColor="#CCFFFE"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Ícono brújula -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle_white_alpha">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_compass"
                            app:tint="#FFFFFF"
                            android:contentDescription="Rutas"/>
                    </FrameLayout>

                </LinearLayout>

                <!-- ── TABS ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Tab Mis Rutas -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tabRutas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis Rutas"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"/>

                        <!-- Indicador activo: blanco sólido -->
                        <View
                            android:id="@+id/indicadorRutas"
                            android:layout_width="40dp"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_btn_white_rounded"/>
                    </LinearLayout>

                    <!-- Tab Mis Viajes -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tabHistorial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis Viajes"
                            android:textSize="14sp"
                            android:textColor="#CCFFFE"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"/>

                        <!-- Indicador inactivo: translúcido -->
                        <View
                            android:id="@+id/indicadorHistorial"
                            android:layout_width="40dp"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_btn_white_rounded"
                            android:alpha="0.3"
                            android:visibility="invisible"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════
         CONTENIDO SCROLLABLE
    ════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="190dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:background="#F0FAFA"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ════════════════════════════════════════════
                 PANEL: MIS RUTAS
            ════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/panelRutas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRutas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- Empty state rutas -->
                <LinearLayout
                    android:id="@+id/layoutEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="48dp"
                    android:paddingBottom="48dp"
                    android:visibility="gone">

                    <!-- Imagen del carro — aparece cuando no hay rutas -->
                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="120dp"
                        android:src="@drawable/moviflesx"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:alpha="0.7"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="Sin rutas"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin rutas creadas"
                        android:textColor="#1A2F4A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Las rutas aparecerán aquí cuando&#10;las crees desde el mapa"
                        android:textColor="#7A9BAA"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ════════════════════════════════════════════
                 PANEL: HISTORIAL
            ════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/panelHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:visibility="gone">

                <!-- Empty historial -->
                <LinearLayout
                    android:id="@+id/layoutEmptyHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="48dp"
                    android:paddingBottom="48dp"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E0FFFE"
                        app:strokeWidth="0dp">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_compass"
                            app:tint="#00CED1"
                            android:contentDescription="Sin viajes"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin viajes finalizados aún"
                        android:textColor="#1A2F4A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Los viajes completados aparecerán aquí"
                        android:textColor="#7A9BAA"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>

                <!-- ════════════════════════════════════
                     SECCIÓN: Por calificar
                ════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/sectionPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp">

                    <!-- Encabezado naranja -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⭐ Por calificar"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A2F4A"/>

                        <!-- Chip contador naranja -->
                        <TextView
                            android:id="@+id/txtContadorPendientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@drawable/bg_chip_orange"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPendientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D0ECEC"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>

                <!-- ════════════════════════════════════
                     SECCIÓN: Ya calificados
                ════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/sectionCalificados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Encabezado teal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_line_teal_rounded"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✅ Ya calificados"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A2F4A"/>

                        <!-- Chip contador teal -->
                        <TextView
                            android:id="@+id/txtContadorCalificados"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@drawable/bg_chip_teal"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCalificados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>