<?xml version="1.0" encoding="utf-8"?>
<!--
    Animación de entrada para cada item del RecyclerView.
    Slide desde abajo + fade in  →  usado en ConversacionAdapter.onBindViewHolder
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">

    <translate
        android:fromYDelta="30dp"
        android:toYDelta="0dp"
        android:duration="280"/>

    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="280"/>

</set>