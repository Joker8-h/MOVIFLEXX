<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>

            <gradient
                android:startColor="#00C9FF"
                android:endColor="#92FE9D"
                android:angle="45"/>

            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp"/>
        </shape>
    </item>

</ripple>