<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Con foco: borde teal -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:color="#1ABC9C" android:width="2dp"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <!-- Con texto / activado: borde teal suave -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0FDF9"/>
            <stroke android:color="#1ABC9C" android:width="1.5dp"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <!-- Normal: borde gris -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:color="#BDBDBD" android:width="1.5dp"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>