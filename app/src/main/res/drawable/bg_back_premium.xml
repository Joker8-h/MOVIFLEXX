<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#D9F4F1">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>

            <gradient
                android:startColor="#D9F4F1"
                android:endColor="#D9F4F1"
                android:angle="135"/>

            <stroke
                android:width="1dp"
                android:color="#D9F4F1"/>
        </shape>
    </item>

</ripple>