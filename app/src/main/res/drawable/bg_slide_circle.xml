<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra exterior difuminada -->
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="6dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#203DCFC7"/>
        </shape>
    </item>
    <!-- Círculo principal teal -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#5CE8E0"
                android:centerColor="#3DCFC7"
                android:endColor="#28B5AD"
                android:angle="135"
                android:type="linear"/>
            <stroke android:width="2.5dp" android:color="#60FFFFFF"/>
        </shape>
    </item>
</layer-list>