<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del buscador integrado en el header teal.
    → Esquinas superiores redondeadas (16dp)
    → Esquinas inferiores rectas (se une con el RecyclerView blanco)
    → Color blanco para crear la transición header→lista
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#DFF7F5" />

    <corners
        android:topLeftRadius="120dp"
        android:topRightRadius="120dp"
        android:bottomLeftRadius="120dp"
        android:bottomRightRadius="120dp" />

</shape>