<?xml version="1.0" encoding="utf-8"?>
<!--
    FONDO IA PROFESIONAL
    Estética: Minimalismo técnico / Neural Grid
    Paleta: Blanco puro → Gris neblina frío
    Concepto: Como si fuera la interfaz de una IA avanzada —
              limpia, precisa, con profundidad sutil.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BASE: Blanco puro a gris neblina muy suave -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F7F8FA"
                android:endColor="#EDEEF2"
                android:angle="135" />
        </shape>
    </item>

    <!-- CAPA 2: Resplandor blanco central (efecto pantalla encendida) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#CCFFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- CAPA 3: Sombra fría muy sutil en esquina superior izquierda -->
    <item
        android:left="-300dp"
        android:top="-300dp">
        <shape android:shape="oval">
            <size
                android:width="600dp"
                android:height="600dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:startColor="#0D9EB3C8"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- CAPA 4: Sombra fría muy sutil en esquina inferior derecha -->
    <item
        android:right="-300dp"
        android:bottom="-300dp">
        <shape android:shape="oval">
            <size
                android:width="600dp"
                android:height="600dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:startColor="#0A8FA3B5"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- CAPA 5: Línea divisora horizontal muy sutil (efecto grid de IA) -->
    <item
        android:top="380dp"
        android:bottom="370dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@android:color/transparent"
                android:centerColor="#12B0BEC8"
                android:endColor="@android:color/transparent"
                android:angle="0" />
        </shape>
    </item>

    <!-- CAPA 6: Vignette perimetral muy sutil para dar profundidad -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:startColor="@android:color/transparent"
                android:endColor="#0A000000" />
        </shape>
    </item>

</layer-list>