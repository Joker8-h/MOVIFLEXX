<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="DomiFlex"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moviflexx"
        android:usesCleartextTraffic="true">
        <activity android:name=".Creacionderutas" android:exported="false" />
        <activity android:name=".PeriflConductor" android:exported="false" />
        <activity android:name=".vehiculos" android:exported="false" />
        <activity android:name=".controller.Conductorstart" android:exported="true" />
        <activity android:name=".controller.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- DomiFlex Fase 3 Activities -->
        <activity android:name=".controller.domiflex.LandingActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.LoginActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.RegisterActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.RestaurantesActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.RestauranteDetalleActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.CarritoActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.PedidoDetalleActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.TrackingActivity" android:exported="false"/>
        <activity android:name=".controller.domiflex.PerfilActivity" android:exported="false"/>
    </application>

</manifest>
